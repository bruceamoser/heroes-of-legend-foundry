<section class="hol-body hol-native-card hol-item-card hol-approved-item-card">
  <div class="hol-card-fixed"><div class="hol-card-toolbar">{{#if editable}}<button type="button" data-action="cardEdit">{{#if cardEditing}}✓ Done{{else}}✎ Edit{{/if}}</button>{{/if}}</div>
  <header class="hol-item-header"><div class="hol-item-identity"><img class="hol-item-mark" src="{{cardMark}}" alt=""><div><h1>{{item.name}}</h1><p>Equipment</p></div></div><dl class="hol-item-vitals"><div><dt>Qty</dt><dd><input aria-label="Quantity" data-item-quantity type="number" min="0" step="1" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}}></dd></div><div><dt>Bulk</dt><dd>{{system.bulk}}</dd></div><div><dt>Coins</dt><dd>{{cardPrice}}</dd></div></dl></header></div>
  <div class="hol-card-scroll"><div class="hol-item-layout">
    <article class="hol-item-rule-card"><div class="hol-item-rule-body" data-item-rules>{{{descriptionHTML}}}</div></article>
    {{#if potion}}<div class="hol-item-use"><button type="button" class="hol-primary" data-action="usePotion">Use healing potion</button></div>{{/if}}
    <aside class="hol-item-boxes">
      {{#if cardProperties}}<details data-card-section="properties" {{#unless cardCollapsed.properties}}open{{/unless}}><summary>Properties</summary>{{#each cardProperties}}<div class="hol-item-stat-row"><span>{{name}}</span><strong>{{value}}</strong></div>{{/each}}{{#if owned}}<button type="button" data-action="hands">Equipment arrangement</button>{{/if}}</details>{{else}}{{#if owned}}<details data-card-section="properties" {{#unless cardCollapsed.properties}}open{{/unless}}><summary>Properties</summary><button type="button" data-action="hands">Equipment arrangement</button></details>{{/if}}{{/if}}
      {{#if cardHasSupply}}<details data-card-section="supply" {{#unless cardCollapsed.supply}}open{{/unless}}><summary>Supply</summary><div class="hol-item-supply">{{#if system.inventoryDie}}d{{system.inventoryDie}}{{else}}Empty{{/if}}</div>{{#if canCheckSupply}}<button type="button" data-action="supply">Check supply after use</button>{{/if}}{{#if canResupply}}<button type="button" data-action="resupply">Resupply one step</button>{{/if}}</details>{{/if}}
      {{#if cardRequirements}}<details data-card-section="requirements" {{#unless cardCollapsed.requirements}}open{{/unless}}><summary>Requirements</summary>{{#each cardRequirements}}<div class="hol-item-stat-row"><span>{{name}}</span><strong>{{value}}</strong></div>{{/each}}</details>{{/if}}
    </aside>
    <details data-card-section="itemNotes" {{#unless cardCollapsed.itemNotes}}open{{/unless}}><summary>Notes</summary>{{#if customDescriptionHTML}}<div>{{{customDescriptionHTML}}}</div>{{/if}}{{#if cardEditing}}<textarea name="flags.heroes-of-legend.itemNotes" rows="3" maxlength="10000" placeholder="Notes for this item…">{{itemNotes}}</textarea>{{else}}<p class="hol-item-notes">{{#if itemNotes}}{{itemNotes}}{{else}}No notes.{{/if}}</p>{{/if}}</details>
    <details data-card-section="provenance"><summary>Source & implementation</summary><div data-item-provenance></div>{{#if cardSourcePath}}<a href="#" data-hol-rule-path="{{cardSourcePath}}">Read full rules reference</a>{{/if}}</details>
  </div>
{{#if cardEditing}}<fieldset {{#unless editable}}disabled{{/unless}}>
<label>Name<input name="name" value="{{item.name}}"></label><div class="hol-pair"><label>Quantity<input type="number" name="system.quantity" min="0" step="1" value="{{system.quantity}}"></label><label>Bulk per item<input type="number" name="system.bulk" min="0" step="1" value="{{system.bulk}}"></label><label>Hands required<input type="number" name="system.hands" {{#if owned}}readonly{{/if}} min="0" max="2" step="1" value="{{system.hands}}"></label><label>Supply die (0: no supply)<input type="number" name="system.inventoryDie" min="0" max="20" step="1" value="{{system.inventoryDie}}"></label></div><label>Description<textarea name="system.description" rows="4">{{system.description}}</textarea></label>{{#if editable}}<button type="submit" class="hol-primary">Save changes</button>{{/if}}</fieldset>{{/if}}</div></section>
