<section class="hol-character-sheet">
  <header class="hol-character-header"><div class="hol-character-heading"><div class="hol-portrait-space" data-hol-portrait><img data-portrait-image src="{{actor.img}}" alt="{{actor.name}} portrait" role="button" tabindex="0" {{#if editable}}data-action="editImage" data-edit="img" title="Change portrait with Foundry's image browser; selection saves automatically" aria-label="Change {{actor.name}} portrait"{{else}}data-action="viewPortrait" title="View portrait" aria-label="View {{actor.name}} portrait"{{/if}}><div class="hol-portrait-controls"><button type="button" data-action="viewPortrait" title="View full portrait">View</button></div></div><div class="hol-character-heading-copy">
    <div class="hol-character-title">{{#if owned}}<button type="button" data-action="toggleEdit" class="hol-edit-toggle" aria-pressed="{{editMode}}"><i class="fa-solid fa-pen" aria-hidden="true"></i> {{#if editMode}}Done{{else}}Edit{{/if}}</button>{{/if}}<h1>{{actor.name}}</h1><button type="button" data-action="death" class="hol-death-button" aria-label="Death roll; {{deathMarks}} failed" title="Death roll · {{deathMarks}} failed"><i class="fa-solid fa-skull" aria-hidden="true"></i>{{#if deathMarks}} {{deathMarks}}{{/if}}</button><span>Level {{level}} ({{dp}} DP)</span></div>
    <p class="hol-character-origin">{{identity}} · Level {{level}}({{dp}})</p>
    <div class="hol-character-vitals">
      <div class="hol-header-hp"><small>HP</small><strong><input data-current-hp type="text" inputmode="text" min="0" max="{{system.health.max}}" step="1" aria-label="Current HP" value="{{system.health.value}}" {{#unless owned}}disabled{{/unless}}><span>/ {{system.health.max}}</span></strong></div>
      <button type="button" data-action="spendGrit" title="Spend Grit"><span>Grit</span><strong>{{system.grit.available}}</strong></button>
      <div class="hol-header-speed"><small>Speed</small><strong>{{movement.speed}}{{#if movement.speedReduced}} / {{movement.unencumbered}}{{/if}}</strong></div><button type="button" data-action="wounds"><span>Wounds</span><strong>{{priorWounds}}</strong></button><div class="hol-header-armor"><small>Armor DR</small><strong>{{armorDr}}</strong></div>

      <small class="sr-only">{{survivalStatus}}{{#if dyingDue}} · Death roll due{{/if}}</small>
    </div>
    </div></div></header><div class="hol-character-attributes">{{#each attributes}}<button type="button" data-action="rollAttribute" data-attribute="{{key}}" title="Roll {{label}}"><span>{{label}}</span><strong>{{signedEffective}}</strong></button>{{/each}}</div>

  <div class="hol-character-frame">
    <nav class="hol-character-tabs" role="tablist" aria-label="Character sheet" aria-orientation="vertical">{{#each tabs}}<button type="button" data-action="switchTab" data-tab="{{id}}" title="{{label}}" aria-label="{{label}}" role="tab" id="hol-tab-{{../actor.id}}-{{id}}" aria-controls="hol-pane-{{../actor.id}}-{{id}}" aria-selected="{{active}}" tabindex="{{#if active}}0{{else}}-1{{/if}}" {{#if active}}aria-current="page"{{/if}}>{{{navIcon}}}<span>{{label}}</span></button>{{/each}}</nav>
    <main class="hol-character-content">
      <section data-tab-pane="main" id="hol-pane-{{actor.id}}-main" role="tabpanel" aria-labelledby="hol-tab-{{actor.id}}-main" {{#unless mainTab}}hidden{{/unless}}>{{#unless created}}{{#if owned}}<button type="button" data-action="createHero">Create or resume character</button>{{/if}}{{/unless}}
<div class="hol-main-layout"><div class="hol-main-actions"><details data-disclosure="favorites" open><summary>Favorites</summary><div class="hol-table-wrap"><table class="hol-action-table"><thead><tr><th>Action</th><th>Attribute</th><th>Effect</th></tr></thead><tbody>{{#each favorites}}<tr class="draggable" data-item-id="{{id}}" data-ability-row data-search-name="{{name}}" data-discipline-ids="{{disciplineIds}}"><td><div class="hol-action-name"><button type="button" data-action="openAbility">{{name}}</button>{{#if ../owned}}{{#if canUse}}<button type="button" data-action="useItem" data-use-item-id="{{useItemId}}" data-supply-use="{{supplyUse}}" title="Use {{name}}" aria-label="Use {{name}}" class="hol-action-roll"><svg class="hol-roll-die" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.4"/><circle cx="16" cy="16" r="1.4"/><circle cx="12" cy="12" r="1.4"/></svg></button>{{/if}}{{/if}}</div>{{#if basic}}<small>Basic{{#if sourceNames}} · {{sourceNames}}{{/if}}</small>{{/if}}{{#if ../editMode}}{{#if basic}}<button type="button" data-action="basicVisibility" data-visible="{{shown}}" aria-pressed="{{shown}}">{{#if shown}}Hide{{else}}Show{{/if}}</button>{{/if}}{{/if}}</td><td>{{attribute}}</td><td><span class="hol-brief" title="{{brief}}">{{brief}}</span>{{#if ../owned}}<button type="button" class="hol-star {{#if favorite}}is-favorite{{/if}}" data-action="favorite" aria-label="Favorite {{name}}" aria-pressed="{{favorite}}">{{#if favorite}}★{{else}}☆{{/if}}</button>{{/if}}</td></tr>{{else}}<tr><td colspan="3">None</td></tr>{{/each}}</tbody></table></div></details>{{#each actionGroups}}{{#if entries}}<details data-disclosure="actions-{{disclosureKey}}" open><summary>{{label}}</summary><div class="hol-table-wrap"><table class="hol-action-table"><thead><tr><th>Action</th><th>Attribute</th><th>Effect</th></tr></thead><tbody>{{#each entries}}<tr class="draggable" data-item-id="{{id}}" data-ability-row data-search-name="{{name}}" data-discipline-ids="{{disciplineIds}}"><td><div class="hol-action-name"><button type="button" data-action="openAbility">{{name}}</button>{{#if ../../owned}}<button type="button" data-action="useItem" title="Use {{name}}" aria-label="Use {{name}}" class="hol-action-roll"><svg class="hol-roll-die" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.4"/><circle cx="16" cy="16" r="1.4"/><circle cx="12" cy="12" r="1.4"/></svg></button>{{/if}}</div>{{#if basic}}<small>Basic</small>{{/if}}{{#if ../../editMode}}{{#if basic}}<button type="button" data-action="basicVisibility" data-visible="{{shown}}" aria-pressed="{{shown}}">{{#if shown}}Hide{{else}}Show{{/if}}</button>{{/if}}{{/if}}</td><td>{{attribute}}</td><td><span class="hol-brief" title="{{brief}}">{{brief}}</span>{{#if ../../owned}}<button type="button" class="hol-star {{#if favorite}}is-favorite{{/if}}" data-action="favorite" aria-label="Favorite {{name}}" aria-pressed="{{favorite}}">{{#if favorite}}★{{else}}☆{{/if}}</button>{{/if}}</td></tr>{{else}}<tr><td colspan="3">None</td></tr>{{/each}}</tbody></table></div></details>{{/if}}{{/each}}</div><aside class="hol-play-summary"><details data-disclosure="passives" open><summary>Passives</summary><ul class="hol-compact-list">{{#each passives}}<li data-item-id="{{id}}"><button type="button" data-action="openAbility">{{name}}</button></li>{{else}}<li>None</li>{{/each}}</ul></details><details data-disclosure="ancestry-traits" open><summary>Ancestry traits</summary>{{#each traits}}<p><button type="button" data-action="referenceChoice" data-id="{{id}}">{{name}}</button></p>{{else}}<small>None</small>{{/each}}</details><details data-disclosure="defenses" open><summary>Defenses</summary><dl><dt>Armor / physical DR</dt><dd>{{armorDr}}</dd>{{#each resistances}}<dt>{{type}} resistance</dt><dd>{{value}}</dd>{{/each}}{{#each weaknesses}}<dt>{{type}} weakness</dt><dd>{{value}}</dd>{{/each}}</dl></details><details data-disclosure="conditions" open><summary>Conditions</summary>{{#if owned}}<button type="button" data-action="addCondition">Add</button>{{/if}}<div class="hol-condition-list">{{#each conditionSources}}<span class="hol-condition-chip"><button type="button" data-action="conditionDetails" data-key="{{key}}">{{key}}</button>{{#unless binary}} {{rating}}{{#if duration}} turns{{/if}}{{/unless}}{{#if starred}} ★{{/if}}{{#if ../owned}}<button type="button" data-action="adjustCondition" data-id="{{id}}" data-delta="-1" aria-label="Decrease {{key}}">−</button>{{#unless binary}}<button type="button" data-action="adjustCondition" data-id="{{id}}" data-delta="1" aria-label="Increase {{key}}">+</button>{{/unless}}{{#if canApply}}<button type="button" data-action="applyConditionDamage" data-key="{{key}}">Apply</button>{{/if}}<button type="button" data-action="removeCondition" data-id="{{id}}" data-key="{{key}}" aria-label="Remove {{key}}">×</button>{{/if}}</span>{{else}}<small>None</small>{{/each}}</div></details><details data-disclosure="movement-carrying" open><summary>Movement & carrying</summary><dl><dt>Speed</dt><dd>{{movement.speed}} squares</dd><dt>Bulk / capacity</dt><dd>{{bulk}} / {{movement.capacity}}</dd><dt>Encumbrance</dt><dd>{{movement.encumbrance}}</dd><dt>Base stability</dt><dd>{{development.creationSummary.stability}}</dd></dl></details><details data-disclosure="supplies" open><summary>Supplies</summary><ul class="hol-compact-list">{{#each equipmentRows}}{{#if carried}}{{#if hasSupply}}<li data-item-id="{{id}}"><button type="button" data-action="openAbility">{{name}}</button><span>{{supplyLabel}}</span>{{#if ../owned}}<button type="button" data-action="supply" aria-label="Supply check {{name}}"><svg class="hol-roll-die" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.4"/><circle cx="16" cy="16" r="1.4"/><circle cx="12" cy="12" r="1.4"/></svg></button><button type="button" data-action="resupply" aria-label="Resupply {{name}}">↥</button><button type="button" data-action="depleteSupply" title="Deplete {{name}}" aria-label="Deplete {{name}}">∅</button>{{/if}}</li>{{/if}}{{/if}}{{/each}}</ul></details></aside></div></section>
      <section data-tab-pane="character" id="hol-pane-{{actor.id}}-character" role="tabpanel" aria-labelledby="hol-tab-{{actor.id}}-character" {{#unless characterTab}}hidden{{/unless}}>
        <h2>Character</h2><div class="hol-character-columns"><section class="hol-character-box"><h3>Origins</h3><table class="hol-origins-table"><tbody>{{#each origins}}<tr><td>{{label}}</td><td>{{name}}</td></tr>{{/each}}</tbody></table></section><section class="hol-character-box"><div class="hol-section-heading"><h3>Languages</h3>{{#if owned}}<button type="button" data-action="addLanguage">Add</button>{{/if}}</div><table class="hol-language-table"><tbody>{{#each languages}}<tr><td>{{name}}</td><td>{{formLabel}}</td><td>{{#if ../owned}}<button type="button" data-action="removeLanguage" data-id="{{id}}" aria-label="Remove language {{name}}">×</button>{{/if}}</td></tr>{{else}}<tr><td colspan="3">None</td></tr>{{/each}}</tbody></table></section></div>
        <details data-disclosure="story" open><summary>Story</summary><textarea aria-label="Story" name="system.biography" rows="5" {{#unless owned}}disabled{{/unless}}>{{system.biography}}</textarea>{{#if editMode}}<label>Message by Heart (up to 50 words)<textarea name="system.memorizedMessage" rows="3" maxlength="5000" {{#unless owned}}disabled{{/unless}}>{{system.memorizedMessage}}</textarea></label>{{/if}}</details>
        <details data-disclosure="wounds" open><summary>Wounds and scars</summary><p class="hol-wound-count">{{priorWounds}} prior wounds counted for future wound rolls. Scar notes do not change this count.</p><table class="hol-wounds-table"><thead><tr><th>Wound / scar</th><th>Active effects</th><th>Treatment</th><th>Progress</th><th>Apply healing</th></tr></thead><tbody>{{#each wounds}}<tr><td><button type="button" data-action="woundDetails" data-event-id="{{eventId}}"><strong>{{injury}}</strong></button>{{#if manual}}<small>Manual record</small>{{/if}}</td><td>{{effectSummary}}</td><td>{{#if remedy}}{{remedy}}{{else}}—{{/if}}</td><td>{{#if recoveryValue}}{{recoveryProgress}} / {{recoveryValue}}{{else}}—{{/if}}</td><td>{{#if canTreat}}<div class="hol-inline-healing"><button type="button" data-action="treatWound" data-event-id="{{eventId}}" data-progress="1">1</button><button type="button" data-action="treatWound" data-event-id="{{eventId}}" data-progress="2">2</button><button type="button" data-action="treatWound" data-event-id="{{eventId}}" data-progress="3">3</button></div>{{/if}}{{#if manual}}{{#if ../owned}}<button type="button" data-action="removeScar" data-event-id="{{eventId}}" aria-label="Remove scar note {{injury}}">Remove note</button>{{/if}}{{else}}{{#if ../owned}}<button type="button" data-action="removeWound" data-event-id="{{eventId}}" aria-label="Remove wound {{injury}}">Remove wound</button>{{/if}}{{/if}}</td></tr>{{else}}<tr><td colspan="5">No recorded wounds.</td></tr>{{/each}}</tbody></table>{{#if owned}}<button type="button" data-action="addScar">Add scar note</button>{{/if}}<button type="button" data-action="wounds">Wound rolls and details</button></details>
        {{#if development.specialties}}<section class="hol-character-box"><h3>Specialties</h3>{{#each development.specialties}}<p>A Party Piece: {{specialty}}</p>{{/each}}</section>{{/if}}
        {{#if editMode}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Character values</legend><label>Name<input name="name" type="text" value="{{actor.name}}" required></label><div class="hol-attributes">{{#each attributes}}<label>{{label}}<input name="system.attributes.{{key}}.base" type="number" value="{{base}}" min="-2" max="2" step="1" required></label>{{/each}}</div><p>Attribute total {{system.attributeTotal}} / +3</p><div class="hol-pair"><label>Current HP<input name="system.health.value" type="number" min="0" value="{{system.health.value}}"></label><label>Base maximum HP<input name="system.health.baseMax" type="number" min="1" value="{{system.health.baseMax}}"></label><label>Granted Grit<input name="system.grit.granted" type="number" min="0" value="{{system.grit.granted}}"></label><label>Spent Grit<input name="system.grit.spent" type="number" min="0" value="{{system.grit.spent}}"></label></div><button type="submit">Save values</button></fieldset>{{/if}}
      </section>
      <section data-tab-pane="abilities" id="hol-pane-{{actor.id}}-abilities" role="tabpanel" aria-labelledby="hol-tab-{{actor.id}}-abilities" {{#unless abilitiesTab}}hidden{{/unless}}><section class="hol-known-disciplines"><h3>Known disciplines</h3><table class="hol-rank-table"><thead><tr><th>Discipline</th><th>Rank</th><th>Discipline</th><th>Rank</th></tr></thead><tbody>{{#each rankPairs}}<tr><td>{{left.name}}</td><td>{{left.rank}}</td><td>{{right.name}}</td><td>{{right.rank}}</td></tr>{{else}}<tr><td colspan="4">None</td></tr>{{/each}}</tbody></table></section><div class="hol-ability-search"><label>Search abilities<input type="search" data-ability-search placeholder="Search by name"></label><label>Discipline<select data-ability-filter><option value="all">All</option>{{#each disciplineFilters}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label></div>{{#each learnedGroups}}<section class="hol-action-group"><h3>{{label}}</h3><div class="hol-table-wrap"><table class="hol-action-table"><thead><tr><th>Action</th><th>Attribute</th><th>Effect</th></tr></thead><tbody>{{#each entries}}<tr class="draggable" data-item-id="{{id}}" data-ability-row data-search-name="{{name}}" data-discipline-ids="{{disciplineIds}}"><td><div class="hol-action-name">{{#if ../../owned}}<button type="button" class="hol-star {{#if favorite}}is-favorite{{/if}}" data-action="favorite" aria-label="Favorite {{name}}" aria-pressed="{{favorite}}">{{#if favorite}}★{{else}}☆{{/if}}</button>{{/if}}<button type="button" data-action="openAbility">{{name}}</button>{{#if ../../owned}}<button type="button" data-action="useItem" title="Use {{name}}" aria-label="Use {{name}}" class="hol-action-roll"><svg class="hol-roll-die" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.4"/><circle cx="16" cy="16" r="1.4"/><circle cx="12" cy="12" r="1.4"/></svg></button>{{/if}}</div>{{#if basic}}<small>Basic</small>{{/if}}{{#if ../../editMode}}{{#if basic}}<button type="button" data-action="basicVisibility" data-visible="{{shown}}" aria-pressed="{{shown}}">{{#if shown}}Hide{{else}}Show{{/if}}</button>{{/if}}{{/if}}</td><td>{{attribute}}</td><td><span class="hol-brief" title="{{brief}}">{{brief}}</span></td></tr>{{else}}<tr><td colspan="3">None</td></tr>{{/each}}</tbody></table></div></section>{{/each}}<details data-disclosure="basic-actions"><summary>Basic actions</summary><div class="hol-table-wrap"><table class="hol-action-table"><thead><tr><th>Action</th><th>Attribute</th><th>Effect</th></tr></thead><tbody>{{#each basicAbilities}}<tr class="draggable" data-item-id="{{id}}" data-ability-row data-search-name="{{name}}" data-discipline-ids="{{disciplineIds}}"><td><div class="hol-action-name">{{#if ../owned}}<button type="button" class="hol-star {{#if favorite}}is-favorite{{/if}}" data-action="favorite" aria-label="Favorite {{name}}" aria-pressed="{{favorite}}">{{#if favorite}}★{{else}}☆{{/if}}</button>{{/if}}<button type="button" data-action="openAbility">{{name}}</button>{{#if ../owned}}<button type="button" data-action="useItem" title="Use {{name}}" aria-label="Use {{name}}" class="hol-action-roll"><svg class="hol-roll-die" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.4"/><circle cx="16" cy="16" r="1.4"/><circle cx="12" cy="12" r="1.4"/></svg></button>{{/if}}</div>{{#if basic}}<small>Basic</small>{{/if}}{{#if ../editMode}}{{#if basic}}<button type="button" data-action="basicVisibility" data-visible="{{shown}}" aria-pressed="{{shown}}">{{#if shown}}Hide{{else}}Show{{/if}}</button>{{/if}}{{/if}}</td><td>{{attribute}}</td><td><span class="hol-brief" title="{{brief}}">{{brief}}</span></td></tr>{{else}}<tr><td colspan="3">None</td></tr>{{/each}}</tbody></table></div></details></section>
      <section data-tab-pane="inventory" id="hol-pane-{{actor.id}}-inventory" role="tabpanel" aria-labelledby="hol-tab-{{actor.id}}-inventory" {{#unless inventoryTab}}hidden{{/unless}}><div class="hol-section-heading"><h2>Inventory</h2>{{#if owned}}<button type="button" data-action="addEquipment">Add equipment</button>{{/if}}</div><div class="hol-inventory-stats"><span><strong>{{development.coins}}</strong> coins</span><span><strong>{{bulk}} / {{movement.capacity}}</strong> Bulk</span><span>Encumbrance <strong>{{movement.encumbrance}}</strong></span><span>Speed <strong>{{movement.speed}}</strong></span><span>Armor DR <strong>{{armorDr}}</strong></span></div><div class="hol-table-wrap"><table class="hol-inventory-table"><thead><tr><th>Item</th><th>Qty</th><th>Bulk</th><th>Supply</th><th>Held</th><th>Worn</th><th>Carried</th><th></th></tr></thead><tbody>{{#each equipmentRows}}<tr data-item-id="{{id}}" class="draggable {{#unless carried}}hol-stored-item{{/unless}}"><td><button type="button" data-action="favorite" class="hol-star {{#if favorite}}is-favorite{{/if}}" aria-label="Favorite {{name}}" {{#unless ../owned}}disabled{{/unless}}>{{#if favorite}}★{{else}}☆{{/if}}</button><button type="button" data-action="openAbility">{{name}}</button>{{#if ../owned}}<button type="button" class="hol-item-pencil" data-action="editEquipment" title="Edit {{name}}" aria-label="Edit {{name}}"><i class="fa-solid fa-pencil" aria-hidden="true"></i></button>{{/if}}<small class="hol-item-source">{{sourceLabel}}</small>{{#if ranged}}<label class="hol-ammunition-label">Ammunition<select data-ammunition-for="{{id}}" aria-label="Ammunition for {{name}}" {{#unless ../owned}}disabled{{/unless}}><option value="">Assign ammunition</option>{{#each ammunitionOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}{{#if needsGrip}}{{#if ../owned}}<button type="button" data-action="equipment">Set hands used</button>{{else}}<small>Hands used unspecified</small>{{/if}}{{/if}}</td><td><input type="number" min="0" step="1" data-quantity="{{id}}" aria-label="Quantity {{name}}" value="{{system.quantity}}" {{#unless ../owned}}disabled{{/unless}}></td><td>{{bulk}}</td><td>{{#if hasSupply}}{{supplyLabel}}{{#if ../owned}}<button type="button" data-action="supply" aria-label="Supply check {{name}}"><svg class="hol-roll-die" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8" r="1.5"/><circle cx="16" cy="16" r="1.5"/><circle cx="12" cy="12" r="1.5"/></svg></button><button type="button" data-action="resupply" aria-label="Resupply {{name}}">↥</button><button type="button" data-action="depleteSupply" title="Deplete {{name}}" aria-label="Deplete {{name}}">∅</button>{{/if}}{{else}}—{{/if}}</td><td>{{#if canHold}}<input type="checkbox" data-arrangement="{{id}}" data-prop="held" aria-label="Hold {{name}}" {{#if system.held}}checked{{/if}} {{#unless ../owned}}disabled{{/unless}}>{{else}}—{{/if}}</td><td>{{#if canWear}}<input type="checkbox" data-arrangement="{{id}}" data-prop="worn" aria-label="Wear {{name}}" {{#if system.worn}}checked{{/if}} {{#unless ../owned}}disabled{{/unless}}>{{else}}—{{/if}}</td><td><input type="checkbox" data-arrangement="{{id}}" data-prop="carried" aria-label="Carry {{name}}" {{#if carried}}checked{{/if}} {{#unless ../owned}}disabled{{/unless}}></td><td>{{#if ../owned}}<button type="button" data-action="removeEquipment" aria-label="Delete {{name}}">×</button>{{/if}}</td></tr>{{else}}<tr><td colspan="7">No equipment.</td></tr>{{/each}}</tbody></table></div></section>
      <section data-tab-pane="development" id="hol-pane-{{actor.id}}-development" role="tabpanel" aria-labelledby="hol-tab-{{actor.id}}-development" {{#unless developmentTab}}hidden{{/unless}}><h2>Development</h2><section class="hol-character-box hol-training"><div class="hol-section-heading"><h3>Training</h3>{{#if owned}}{{#if created}}<button type="button" data-action="advanceHero">Develop</button>{{else}}<button type="button" data-action="createHero">Edit creation</button>{{/if}}{{/if}}</div><div class="hol-development-summary"><div><small>Level</small><strong>{{level}}</strong></div><div><small>Current DP</small><strong>{{dp}}</strong></div><div><small>DP spent</small><strong>{{dpSpent}}</strong></div><div><small>Total DP</small><strong>{{dpTotal}}</strong></div></div>{{#if overspent}}<p class="hol-error"><strong>Overspent: remove abilities</strong></p>{{/if}}{{#if owned}}{{#if created}}<div class="hol-level-controls"><button type="button" data-action="addLevel">Add level</button>{{#if canRemoveLevel}}<button type="button" data-action="removeLevel">Remove level</button>{{/if}}</div>{{/if}}{{/if}}</section><details data-disclosure="signatures" open><summary>Class signatures</summary><table class="hol-inventory-table"><thead><tr><th>Level</th><th>Signature</th><th></th></tr></thead><tbody>{{#each signatureTiers}}<tr data-item-id="{{id}}"><td>{{tier}}</td><td>{{#if name}}<button type="button" data-action="openAbility">{{name}}</button>{{else}}{{#if available}}Choose a signature{{else}}Available at level {{tier}}{{/if}}{{/if}}</td><td>{{#if missing}}{{#if ../owned}}<button type="button" data-action="advanceHero">Choose level {{tier}} signature</button>{{/if}}{{else}}{{#if name}}✓{{else}}—{{/if}}{{/if}}</td></tr>{{/each}}</tbody></table></details><details data-disclosure="advancement-history" open><summary>Advancement history</summary><table class="hol-inventory-table"><thead><tr><th>Level</th><th>Entry</th><th>DP</th></tr></thead><tbody>{{#each purchases}}<tr><td>{{level}}</td><td>{{name}}{{#if rank}} · Rank {{rank}}{{/if}}</td><td>{{cost}}</td></tr>{{else}}<tr><td colspan="3">No advancement purchases.</td></tr>{{/each}}</tbody></table></details><details data-disclosure="creation-ledger"><summary>Creation ledger</summary><table class="hol-inventory-table"><thead><tr><th>Stage</th><th>Choice</th><th>DP</th><th>Remaining</th></tr></thead><tbody>{{#each ledger}}<tr><td>Level {{stage}}</td><td>{{label}}{{#if sourceName}} · {{sourceName}}{{/if}}</td><td>{{delta}}</td><td>{{balance}}</td></tr>{{else}}<tr><td colspan="4">No committed creation ledger.</td></tr>{{/each}}</tbody></table></details></section>
      <section data-tab-pane="crafting" id="hol-pane-{{actor.id}}-crafting" role="tabpanel" aria-labelledby="hol-tab-{{actor.id}}-crafting" {{#unless craftingTab}}hidden{{/unless}}><h2>Crafting</h2><div class="hol-table-wrap"><table class="hol-inventory-table"><thead><tr><th>Recipe</th><th>Crafting ability</th><th>Attempt</th><th></th></tr></thead><tbody>{{#each craftingRecipes}}<tr><td><button type="button" data-action="referenceChoice" data-id="{{id}}">{{name}}</button></td><td>{{#each abilities}}{{#unless @first}} / {{/unless}}{{name}}{{else}}Not learned{{/each}}</td><td>{{attemptMinutes}} min</td><td>{{#if available}}{{#if project.active}}In progress{{else}}<button type="button" data-action="startCraft" data-recipe-id="{{id}}" {{#unless ../owned}}disabled{{/unless}}>Start</button>{{/if}}{{else}}—{{/if}}</td></tr>{{/each}}</tbody></table></div><h3>Crafting projects</h3><table class="hol-craft-projects"><thead><tr><th>Project</th><th>Progress</th><th>Roll</th></tr></thead><tbody>{{#each craftingProjects}}<tr data-craft-project="{{id}}"><td><button type="button" data-action="referenceChoice" data-id="{{id}}">{{name}}</button><small>{{attemptMinutes}} min / attempt</small></td><td>{{#if maximumDie}}Supply steps · cap d{{maximumDie}}{{else}}{{project.progress}} / {{target}}<small>{{project.completed}} completed</small><progress value="{{project.progress}}" max="{{target}}" aria-label="{{name}} progress"></progress>{{/if}}</td><td>{{#each abilities}}<button type="button" data-action="attemptCraft" data-ability-id="{{id}}" title="{{name}}" {{#unless ../../owned}}disabled{{/unless}}><svg class="hol-roll-die" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.4"/><circle cx="16" cy="16" r="1.4"/><circle cx="12" cy="12" r="1.4"/></svg>{{attribute}}</button>{{/each}}</td></tr>{{else}}<tr><td colspan="3">Start a recipe to begin a project.</td></tr>{{/each}}</tbody></table><button type="button" data-action="crafting">Review pending attempts and recovery</button></section>
    </main><aside class="hol-character-reference" data-character-reference hidden aria-label="Rules reference"><header><h2>Rules reference</h2><button type="button" data-action="closeReference" aria-label="Close rules reference">×</button></header><div data-rule-content></div></aside>
  </div>
</section>
