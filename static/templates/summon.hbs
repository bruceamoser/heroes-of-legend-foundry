<section class="hol-body hol-creature-sheet hol-summon-sheet hol-native-card"><div class="hol-card-fixed">
<header class="hol-banner"><div class="hol-portrait-space" data-hol-portrait><img data-portrait-image src="{{actor.img}}" alt="{{actor.name}} portrait" role="button" tabindex="0" {{#if editable}}data-action="editImage" data-edit="img" title="Change portrait with Foundry's image browser, then Save portrait" aria-label="Change {{actor.name}} portrait"{{else}}data-action="viewPortrait" title="View portrait" aria-label="View {{actor.name}} portrait"{{/if}}><div class="hol-portrait-controls"><button type="button" data-action="viewPortrait" title="View full portrait">View</button>{{#if editable}}<button type="button" data-action="savePortrait" title="Save the selected portrait image">Save portrait</button>{{/if}}</div></div><p class="hol-kicker">Summoned energy form · {{system.eligibility}}</p><h1>{{actor.name}}</h1><p>CV {{system.cv}}</p></header>

{{#if canUpdateProfile}}<button type="button" data-action="updateProfile" title="Update printed profile and CV; keep live resources and local edits">Update profile</button>{{/if}}
<section aria-label="Printed statistics"><h2>Printed statistics</h2>
<dl class="hol-stat-grid"><div><dt>HP</dt><dd>{{system.health.value}} / {{system.health.max}}</dd></div><div><dt>Speed</dt><dd>{{system.speedSource}}</dd></div><div><dt>Footprint</dt><dd>{{system.footprint.width}} × {{system.footprint.height}}</dd></div><div><dt>Defense modifier</dt><dd>{{defenseLabel}}</dd></div><div><dt>Stability</dt><dd>{{system.stabilitySource}}</dd></div>{{#each attributes}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>
<p><strong>Resistance:</strong> {{system.resistances.sourceText}}</p><p><strong>Weakness:</strong> {{system.weaknesses.sourceText}}</p><p><strong>Condition immunities:</strong> {{#each system.immunities}}{{this}} · {{else}}None{{/each}}</p><p><strong>Senses:</strong> {{system.senses}}</p><p><strong>Communication:</strong> {{system.communication}}</p></section>
</div><div class="hol-card-scroll"><p class="hol-note">Reference profile; lifecycle managed by DA.</p><section aria-label="Basic Melee attacker outcomes"><h2>Basic Melee · attacker outcomes</h2><p>{{system.basicMelee.attribute}} · {{attackLabel}} · one adjacent target · Physical damage</p><dl class="hol-outcome-grid"><div><dt>Weak attack</dt><dd>{{system.basicMelee.weak}}</dd></div><div><dt>Standard attack</dt><dd>{{system.basicMelee.standard}}</dd></div><div><dt>Strong attack</dt><dd>{{system.basicMelee.strong}}</dd></div></dl></section>
<p>{{system.healingSource}}</p>
<details class="hol-creature-reference" data-card-section="commands" {{#unless cardCollapsed.commands}}open{{/unless}}><summary>Commands and source details</summary><div class="hol-item-reference">{{{referenceHTML}}}</div>
<p class="hol-reference-source">{{catalogId}} · {{sourcePath}} at <code>{{sourceCommit}}</code>. Distribution licensing remains undecided.</p>
</details>
</div></section>
