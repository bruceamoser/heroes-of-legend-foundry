<section class="hol-market" data-coins="{{coins}}"><div class="hol-market-balance"><strong>{{coins}} coins remaining</strong></div><div class="hol-market-toolbar"><label>Search equipment<input type="search" data-market-search placeholder="Name or keyword…"></label></div><div class="hol-market-list"><table><thead><tr><th>Item</th><th>Coins</th><th>Bulk</th><th>Supply</th><th>Qty</th><th>Hands</th><th></th></tr></thead><tbody>{{#each rows}}<tr data-market-row data-uuid="{{uuid}}" data-name="{{name}}" data-price="{{price}}" data-base-reason="{{reason}}" class="{{#unless available}}unavailable{{/unless}}"><td><button type="button" data-action="reference" class="hol-table-link">{{name}}</button>{{#if reason}}<small>{{reason}}</small>{{/if}}</td><td>{{#if priced}}{{price}}{{else}}—{{/if}}</td><td>{{bulk}}</td><td>{{supply}}</td><td><input type="number" min="1" max="10000" step="1" value="1" data-market-quantity aria-label="Quantity {{name}}" {{#unless available}}disabled{{/unless}}></td><td>{{#if hands.length}}<select data-market-hands aria-label="Hands {{name}}">{{#each hands}}<option value="{{this}}">{{this}}</option>{{/each}}</select>{{else}}—{{/if}}</td><td><button type="button" data-action="buy" {{#unless available}}disabled{{/unless}}>{{#if priced}}Buy{{else}}Add{{/if}}</button></td></tr>{{/each}}</tbody></table></div></section>
