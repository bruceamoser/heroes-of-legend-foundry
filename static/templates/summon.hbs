<section class="hol-body hol-creature-sheet hol-summon-sheet hol-native-card"><div class="hol-card-fixed">
<header class="hol-banner hol-card-banner"><div class="hol-portrait-space" data-hol-portrait><img data-portrait-image src="{{actor.img}}" alt="{{actor.name}} portrait" role="button" tabindex="0" {{#if editable}}data-action="editImage" data-edit="img" title="Change portrait with Foundry's image browser; selection saves immediately" aria-label="Change {{actor.name}} portrait"{{else}}data-action="viewPortrait" title="View portrait" aria-label="View {{actor.name}} portrait"{{/if}}><div class="hol-portrait-controls"><button type="button" data-action="viewPortrait" title="View full portrait">View</button></div></div><div class="hol-card-identity"><p class="hol-kicker">Summoned energy form · {{system.eligibility}}</p><h1>{{actor.name}}</h1></div><div class="hol-card-vitals"><div><small>HP</small><strong>{{system.health.value}} / {{system.health.max}}</strong></div><div><small>Speed</small><strong>{{system.speedSource}}</strong></div><div><small>CV</small><strong>{{system.cv}}</strong></div></div></header>
<div class="hol-card-attributes">{{#each attributes}}<div class="hol-card-attribute"><small>{{label}}</small><strong>{{value}}</strong></div>{{/each}}</div>
<dl class="hol-card-defenses"><div><dt>Defense modifier</dt><dd>{{defenseLabel}}</dd></div><div><dt>Stability</dt><dd>{{system.stabilitySource}}</dd></div><div><dt>Footprint</dt><dd>{{system.footprint.width}} × {{system.footprint.height}}</dd></div><div><dt>Immunity</dt><dd>{{#each system.immunities}}{{this}} · {{else}}None{{/each}}</dd></div><div><dt>Resistance</dt><dd>{{system.resistances.sourceText}}</dd></div><div><dt>Weakness</dt><dd>{{system.weaknesses.sourceText}}</dd></div></dl>
</div><div class="hol-card-scroll"><p class="hol-combat-label">Attacker outcomes · Commands and lifecycle managed by the DA</p><section aria-label="Basic Melee attacker outcomes"><h2>Basic Melee · attacker outcomes</h2><p>{{system.basicMelee.attribute}} · {{attackLabel}} · one adjacent target · Physical damage</p><dl class="hol-outcome-grid"><div><dt>Weak attack</dt><dd>{{system.basicMelee.weak}}</dd></div><div><dt>Standard attack</dt><dd>{{system.basicMelee.standard}}</dd></div><div><dt>Strong attack</dt><dd>{{system.basicMelee.strong}}</dd></div></dl></section>
<p>{{system.healingSource}}</p><p><strong>Senses:</strong> {{system.senses}}</p><p><strong>Communication:</strong> {{system.communication}}</p>
{{#if canUpdateProfile}}<button type="button" data-action="updateProfile" title="Update printed profile and CV; keep live resources and local edits">Update profile</button>{{/if}}
<details class="hol-creature-reference" data-card-section="commands" {{#unless cardCollapsed.commands}}open{{/unless}}><summary>Commands and source details</summary><div class="hol-item-reference">{{{referenceHTML}}}</div>
<p class="hol-reference-source">{{catalogId}} · {{sourcePath}} at <code>{{sourceCommit}}</code> .</p>
</details>
</div></section>
