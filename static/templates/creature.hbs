<section class="hol-body hol-creature-sheet hol-native-card">

<div class="hol-card-fixed">
<div class="hol-card-toolbar">{{#if editable}}<button type="button" data-action="cardEdit">{{#if cardEditing}}✓ Done{{else}}✎ Edit{{/if}}</button>{{#if cardEditing}}{{#if canNpcPortrayal}}<button type="button" data-action="npcMode">{{#if npcMode}}Use creature view{{else}}Use NPC portrayal{{/if}}</button>{{/if}}{{/if}}{{/if}}{{#if gm}}<button type="button" data-action="recovery">Recovery</button>{{/if}}</div>
<header class="hol-banner hol-card-banner"><div class="hol-portrait-space" data-hol-portrait><img data-portrait-image src="{{actor.img}}" alt="{{actor.name}} portrait" role="button" tabindex="0" {{#if editable}}data-action="editImage" data-edit="img" title="Change portrait with Foundry's image browser; selection saves immediately" aria-label="Change {{actor.name}} portrait"{{else}}data-action="viewPortrait" title="View portrait" aria-label="View {{actor.name}} portrait"{{/if}}><div class="hol-portrait-controls"><button type="button" data-action="viewPortrait" title="View full portrait">View</button></div></div><div class="hol-card-identity"><p class="hol-kicker">{{#if npcMode}}NPC{{else}}Creature{{/if}}{{#if classification}} · {{classification.category}}{{/if}}</p><h1>{{actor.name}}</h1><p>{{#if npcMode}}{{npc.role}}{{#if npc.location}} · {{npc.location}}{{/if}}{{else}}{{family}}{{#if classification.role}} · {{classification.role}}{{/if}}{{/if}}</p></div>{{#if combatLinked}}<div class="hol-card-vitals"><label>HP<input data-current-hp name="system.health.value" type="text" inputmode="text" min="0" max="{{system.health.max}}" value="{{system.health.value}}" {{#unless editable}}disabled{{/unless}}></label><span>/ {{system.health.max}}</span><div><small>Speed</small><strong>{{system.speed}}</strong></div><div><small>CV</small><strong>{{system.cv}}</strong></div></div>{{/if}}</header>
{{#if combatLinked}}
<div class="hol-card-attributes">{{#each attributes}}<button type="button" data-action="rollAttribute" data-attribute="{{key}}" {{#unless ../owned}}disabled{{/unless}}><small>{{label}}</small><strong>{{signed}}</strong></button>{{/each}}</div>
<dl class="hol-card-defenses"><div><dt>Armor DR</dt><dd>{{system.armor}}{{system.armorMarker}}</dd></div><div><dt>Evasion</dt><dd>{{evasionLabel}}</dd></div><div><dt>Threat</dt><dd>{{threatLabel}}</dd></div><div><dt>Stability</dt><dd>{{system.stability}}</dd></div><div><dt>Resistance</dt><dd>{{resistanceLabel}}</dd></div><div><dt>Weakness</dt><dd>{{weaknessLabel}}</dd></div><div><dt>Immunity</dt><dd>{{immunityLabel}}</dd></div></dl>
{{/if}}</div>
<div class="hol-card-scroll">
{{#if combatLinked}}<p class="hol-card-subline">{{system.size}}{{#if system.sizeLabel}} · {{system.sizeLabel}}{{/if}}{{#each alternateSpeeds}} · {{mode}} {{value}}{{/each}}</p>
<p class="hol-combat-label">{{outcomePerspective}} · Weak / Standard / Strong</p>
<section class="hol-card-actions">
{{#each actionGroups}}{{#if hasEntries}}<details data-main="{{main}}" data-card-section="actions-{{@index}}" {{#unless collapsed}}open{{/unless}} class="hol-action-group"><summary>{{label}}</summary><div class="hol-card-table-wrap"><table class="hol-card-action-table"><thead><tr><th>Action</th>{{#if main}}<th>{{../actionAttributeLabel}}</th><th>Weak</th><th>Standard</th><th>Strong</th>{{else}}<th>Effect</th>{{/if}}{{#if ../canDeclare}}<th><span class="sr-only">Post</span></th>{{/if}}</tr></thead><tbody>
{{#if main}}<tr><td>Basic Melee</td><td>{{../system.basicMelee.defenseAttribute}}</td><td>{{../system.basicMelee.weak}}</td><td>{{../system.basicMelee.standard}}</td><td>{{../system.basicMelee.strong}}</td>{{#if ../canDeclare}}<td><button type="button" data-action="npcMelee" title="Declare Basic Melee">Attack</button></td>{{/if}}</tr>{{/if}}
{{#each entries}}<tr><td><button type="button" data-action="viewCreatureAction" data-creature-action="{{id}}">{{name}}</button></td>{{#if ../main}}<td>{{defenseSource}}</td><td>{{outcomes.weak}}</td><td>{{outcomes.standard}}</td><td>{{outcomes.strong}}</td>{{else}}<td>{{effect}}</td>{{/if}}{{#if ../../canDeclare}}<td><button type="button" data-action="creatureAction" data-creature-action="{{id}}" title="{{#if automaticDamage}}Attack{{else}}Post{{/if}} {{name}}">{{#if automaticDamage}}Attack{{else}}Post{{/if}}</button></td>{{/if}}</tr>{{#if context}}<tr class="hol-action-context-row"><td colspan="6">{{context}}</td></tr>{{/if}}{{/each}}
</tbody></table></div></details>{{/if}}{{/each}}</section>
{{#if conditionsList.length}}<details class="hol-card-conditions" data-card-section="conditions" {{#unless cardCollapsed.conditions}}open{{/unless}}><summary><span>Conditions</span>{{#unless conditionsList.length}}<small>No conditions.</small>{{/unless}}</summary>{{#each conditionsList}}<p>{{key}} {{rating}}</p>{{/each}}</details>{{/if}}{{/if}}
{{#if npcMode}}<details data-card-section="portrayal" {{#if portrayalOpen}}open{{/if}}><summary>Portrayal &amp; profile</summary><div class="hol-card-portrayal">
{{#if cardEditing}}<label>Recognizable detail<textarea name="flags.heroes-of-legend.npc.detail" maxlength="10000" rows="2">{{npc.detail}}</textarea></label>{{else}}<div><h3>Recognizable detail</h3><p>{{#if npc.detail}}{{npc.detail}}{{else}}—{{/if}}</p></div>{{/if}}
{{#if cardEditing}}<label>Wants<textarea name="flags.heroes-of-legend.npc.want" maxlength="10000" rows="2">{{npc.want}}</textarea></label>{{else}}<div><h3>Wants</h3><p>{{#if npc.want}}{{npc.want}}{{else}}—{{/if}}</p></div>{{/if}}
{{#if cardEditing}}<label>Knows<textarea name="flags.heroes-of-legend.npc.knowledge" maxlength="10000" rows="2">{{npc.knowledge}}</textarea></label>{{else}}<div><h3>Knows</h3><p>{{#if npc.knowledge}}{{npc.knowledge}}{{else}}—{{/if}}</p></div>{{/if}}
{{#if cardEditing}}<label>Boundary<textarea name="flags.heroes-of-legend.npc.boundary" maxlength="10000" rows="2">{{npc.boundary}}</textarea></label>{{else}}<div><h3>Boundary</h3><p>{{#if npc.boundary}}{{npc.boundary}}{{else}}—{{/if}}</p></div>{{/if}}
{{#if cardEditing}}<label>Relationship<textarea name="flags.heroes-of-legend.npc.relationship" maxlength="10000" rows="2">{{npc.relationship}}</textarea></label>{{else}}<div><h3>Relationship</h3><p>{{#if npc.relationship}}{{npc.relationship}}{{else}}—{{/if}}</p></div>{{/if}}
{{#if cardEditing}}<label>Role<textarea name="flags.heroes-of-legend.npc.role" maxlength="10000" rows="2">{{npc.role}}</textarea></label>{{else}}<div><h3>Role</h3><p>{{#if npc.role}}{{npc.role}}{{else}}—{{/if}}</p></div>{{/if}}
{{#if cardEditing}}<label>Location<textarea name="flags.heroes-of-legend.npc.location" maxlength="10000" rows="2">{{npc.location}}</textarea></label>{{else}}<div><h3>Location</h3><p>{{#if npc.location}}{{npc.location}}{{else}}—{{/if}}</p></div>{{/if}}
</div><p>Combat profile: {{#if combatLinked}}{{#if npc.profileName}}{{npc.profileName}}{{else}}{{actor.name}}{{/if}}{{else}}Hidden · stored statistics still apply to attacks and damage{{/if}}</p>{{#if gm}}<button type="button" data-action="chooseNpcProfile">Choose profile</button>{{#if combatLinked}}<button type="button" data-action="unlinkNpcProfile">Hide combat profile</button>{{/if}}{{/if}}{{#if cardEditing}}<button type="submit">Save portrayal</button>{{/if}}{{#if referenceHTML}}<details data-card-section="reference" {{#if referenceOpen}}open{{/if}} class="hol-creature-reference"><summary>World &amp; specialties</summary><div class="hol-item-reference">{{{referenceHTML}}}</div></details>{{/if}}</details>{{/if}}

{{#unless npcMode}}{{#if referenceHTML}}<details data-card-section="reference" {{#if referenceOpen}}open{{/if}} class="hol-creature-reference"><summary>World &amp; specialties</summary><div class="hol-item-reference">{{{referenceHTML}}}</div></details>{{/if}}{{/unless}}
<details data-card-section="notes" {{#if notesOpen}}open{{/if}}><summary>Notes</summary>{{#if editable}}<textarea name="system.biography" rows="3">{{system.biography}}</textarea><button type="submit">Save notes</button>{{else}}<p>{{system.biography}}</p>{{/if}}<details data-card-section="abilities" ><summary>Ability Items</summary><ul class="hol-ability-list">{{#each abilities}}<li><button type="button" data-action="openAbility" data-item-id="{{id}}">{{name}}</button></li>{{else}}<li>No ability Items.</li>{{/each}}</ul></details>
<details data-card-section="profile-source"><summary>Profile source</summary>{{#if canUpdateProfile}}<button type="button" data-action="updateProfile">Update profile</button>{{/if}}{{#if sourceLink}}<p class="hol-reference-source">{{sourcePath}} · {{sourceCommit}}</p>{{/if}}</details></details>
{{#if cardEditing}}<details class="hol-creature-editor" open>
<summary>Editable native profile</summary>
<fieldset {{#unless editable}}disabled{{/unless}}>
<label>Name<input name="name" value="{{actor.name}}"></label>
<div class="hol-attributes">{{#each attributes}}<label>{{label}}<input name="system.attributes.{{key}}.base" type="number" min="-2" max="2" step="1" value="{{base}}"><button type="button" data-action="rollAttribute" data-attribute="{{key}}">Roll {{label}}</button></label>{{/each}}</div>
<div class="hol-pair">

<label>Maximum HP<input name="system.health.baseMax" type="number" min="1" step="1" value="{{system.health.baseMax}}"></label>
<label>CV<input name="system.cv" type="number" step="1" value="{{system.cv}}"></label>
<label>Printed Speed<input name="system.speed" type="number" min="0" step="1" value="{{system.speed}}"></label>
<label>Size (squares per side)<input name="{{sizeField}}" type="number" min="1" step="1" value="{{system.size}}"></label>
<label>Armor DR (Physical resistance)<input name="system.armor" {{#unless canEditThreatArmor}}disabled{{/unless}} type="number" min="0" max="3" step="1" value="{{system.armor}}"></label>
<label>Stability<input name="system.stability" type="number" min="0" max="3" step="1" value="{{system.stability}}"></label>
</div>
<h2>Evasion · modifier to incoming player attacks</h2><div class="hol-pair"><label>Boons<input name="{{evasionPath}}.boons" type="number" min="0" step="1" value="{{system.evasion.boons}}"></label><label>Banes<input name="{{evasionPath}}.banes" type="number" min="0" step="1" value="{{system.evasion.banes}}"></label></div>
<h2>Threat · modifier to player defenses</h2><div class="hol-pair"><label>Boons<input name="system.threat.boons" {{#unless canEditThreatArmor}}disabled{{/unless}} type="number" min="0" step="1" value="{{system.threat.boons}}"></label><label>Banes<input name="system.threat.banes" {{#unless canEditThreatArmor}}disabled{{/unless}} type="number" min="0" step="1" value="{{system.threat.banes}}"></label></div>
<h2>Basic Melee · physical damage by {{outcomeNoun}} result</h2><div class="hol-attributes"><label>Weak {{outcomeNoun}}<input name="system.basicMelee.weak" type="number" min="0" step="1" value="{{system.basicMelee.weak}}"></label><label>Standard {{outcomeNoun}}<input name="system.basicMelee.standard" type="number" min="0" step="1" value="{{system.basicMelee.standard}}"></label><label>Strong {{outcomeNoun}}<input name="system.basicMelee.strong" type="number" min="0" step="1" value="{{system.basicMelee.strong}}"></label></div>

{{#if editable}}<button type="submit" class="hol-primary">Save changes</button>{{/if}}
</fieldset>
</details>{{/if}}

</div></section>