<section class="hol-tool-shell hol-approved-tool"><header class="hol-tool-banner"><h1>Crafting</h1><small>{{name}}</small></header><div class="hol-tool-content">
{{#if pending}}<section class="hol-tool-box" role="status"><h2>Saved attempt</h2>{{#if canResume}}<button type="button" data-action="resume" {{#unless owned}}disabled{{/unless}}>Apply saved result</button>{{else}}<p>A roll may already have occurred. Record its original result without rerolling.</p>{{#if gm}}{{#if materialRecovery}}<label>Original material supply face<input type="number" name="materialFace" min="1" step="1"></label>{{else}}<label>Original retained crafting dice<input name="retainedCraftDice" placeholder="2, 4, 6"></label>{{/if}}<button type="button" data-action="recover">Record original result and apply</button>{{/if}}{{/if}}</section>{{/if}}
<div class="hol-craft-layout"><aside class="hol-craft-list" aria-label="Recipes">{{#each recipes}}<button type="button" data-action="selectRecipe" data-recipe="{{id}}" aria-pressed="{{selected}}">{{name}}</button>{{else}}<p>No known recipes.</p>{{/each}}</aside><div>
{{#if selected}}<section class="hol-tool-box" data-recipe="{{selected.id}}"><h2>{{selected.name}}</h2><p>{{#each abilities}}{{name}}{{#unless @last}} / {{/unless}}{{/each}} · {{selected.attemptMinutes}} min / attempt · {{#if selected.maximumDie}}cap d{{selected.maximumDie}}{{else}}target {{selected.target}}{{/if}}</p>{{#unless available}}<p>Learn a printed crafting ability to begin this recipe.</p>{{/unless}}<ul class="hol-craft-metadata">{{{metadataHTML}}}</ul><div class="hol-tool-actions"><button type="button" data-action="start" class="hol-primary" {{#unless owned}}disabled{{/unless}} {{#unless available}}disabled{{/unless}}>Begin attempt</button><a href="#" data-hol-rule-path="{{selected.source.path}}">Read rules</a></div></section>
<section class="hol-tool-box">{{#if selected.maximumDie}}<h2>Supply</h2><p>{{productName}} · <strong>{{#if currentDie}}d{{currentDie}}{{else}}Empty{{/if}}</strong></p><label>Starting supply<select name="startingSupply"><option value="">New supply · Empty</option>{{#each supplies}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{#if die}}d{{die}}{{else}}Empty{{/if}}</option>{{/each}}</select></label>{{#if currentSupplyId}}<button type="button" data-action="editSupply" data-item-id="{{currentSupplyId}}">Edit starting supply</button>{{/if}}{{else}}<h2>Project progress</h2><div class="hol-tool-progress"><progress max="{{selected.target}}" value="{{progress}}"></progress><strong>{{progress}} / {{selected.target}}</strong></div><p>{{completed}} finished products</p>{{/if}}</section>{{/if}}
{{#if notice}}<p class="hol-tool-result" role="status">{{notice}}</p>{{/if}}
<section class="hol-tool-box"><h2>Attempts</h2>{{#each jobs}}<div class="hol-item-stat-row"><span>{{name}} · {{minutes}} min{{#if complete}} · Complete{{else}}{{#if requestId}} · Requested{{/if}}{{/if}}</span>{{#if canResolve}}<button type="button" data-action="resolve" data-job-id="{{id}}">Resolve</button>{{/if}}</div>{{else}}<p>No attempts in progress.</p>{{/each}}</section>
{{#if job}}<section class="hol-tool-box hol-craft-resolve"><h2>Resolve {{job.name}}</h2><p>Weak 1 · Standard 2 · Strong 3 {{#if selected.maximumDie}}inventory steps · cap d{{selected.maximumDie}}{{else}}progress · target {{selected.target}}{{/if}}</p><label>Crafting ability<select name="ability">{{#each abilities}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><div class="hol-craft-attribute-fields"><label>Attribute<select name="attribute">{{#each attributes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Value <output data-craft-value></output></label></div><label class="hol-craft-net"><span class="hol-craft-net-heading"><span>Banes</span><output data-craft-net>Even</output><span>Boons</span></span><input type="range" name="adjustment" min="-3" max="3" value="0" step="1" aria-label="Net crafting Banes or Boons"><span class="hol-adjustment-scale"><span>−3 Banes</span><span>0</span><span>+3 Boons</span></span></label><div class="hol-craft-pool" data-craft-pool aria-live="polite"><div><strong data-count>3</strong> d6</div><div><span data-dice aria-hidden="true">⚂ ⚂ ⚂</span><strong data-keep>Keep all three</strong><code>3d6</code></div></div>{{#if selected.maximumDie}}<label>Supply<select name="supply"><option value="">New supply</option>{{#each supplies}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{#if die}}d{{die}}{{else}}Empty{{/if}}</option>{{/each}}</select></label>{{/if}}{{#if materials}}<label class="hol-craft-material-check"><input type="checkbox" name="checkMaterials"> Check a carried material supply after this attempt</label><label>Material supply<select name="materialSupply">{{#each materials}}<option value="{{id}}">{{name}} · d{{die}}</option>{{/each}}</select></label>{{/if}}<button type="button" data-action="attempt" class="hol-primary" {{#unless owned}}disabled{{/unless}}>Complete attempt</button></section>{{/if}}
</div></div><p class="hol-tool-help">Tools, materials and elapsed time are judged at the table. Recorded outcomes update this character’s project and inventory.</p></div></section>
