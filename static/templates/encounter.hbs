<section class="hol-tool-shell hol-approved-tool"><header class="hol-tool-banner"><h1>{{heading}}</h1><small>{{subtitle}}</small></header><div class="hol-tool-content">
<div class="hol-tool-actions">{{#if state}}<button type="button" data-action="opening">Opening roll</button>{{else}}{{#if gm}}<button type="button" data-action="start" class="hol-primary">Start encounter</button>{{/if}}{{/if}}<a href="#" data-hol-rule-path="design/rules/encounters.md">Read rules</a></div>
{{#if state}}<p class="hol-tool-help">Opening {{state.opening.total}} · {{startingSide}} start each round.</p>{{else}}<p class="hol-tool-help">One opening roll, then alternate sides. Add participants through the native combat tracker.</p>{{/if}}
<div class="hol-combat-roster">{{#each sides}}<section class="hol-combat-side"><h2>{{name}}<span>{{ready}} ready</span></h2>{{#each participants}}<div class="hol-combat-row {{#if active}}active{{/if}} {{#if acted}}acted{{/if}}"><button type="button" class="hol-combat-portrait-button" data-action="actor" data-id="{{id}}" aria-label="Open {{name}}"><img class="hol-combat-portrait" src="{{img}}" alt=""></button><div><strong>{{name}}</strong><small>{{status}}{{#unless (eq hp null)}} · HP {{hp}}{{/unless}}{{#if hidden}} · Hidden{{/if}}</small>{{#unless ../../state}}{{#if ../../gm}}<select data-side-id="{{id}}" aria-label="Side for {{name}}"><option value="players" {{#if (eq side "players")}}selected{{/if}}>Players</option><option value="opposition" {{#if (eq side "opposition")}}selected{{/if}}>Opposition</option></select>{{/if}}{{/unless}}</div><div>{{#if canChoose}}<button type="button" data-action="choose" data-id="{{id}}">Choose</button>{{/if}}{{#if canHide}}<button type="button" data-action="hide" data-id="{{id}}" aria-label="{{#if hidden}}Reveal{{else}}Hide{{/if}} {{name}}">{{#if hidden}}◉{{else}}◌{{/if}}</button>{{/if}}</div></div>{{else}}<p class="hol-tool-help">No participants.</p>{{/each}}</section>{{/each}}</div>
{{#if budget}}<div class="hol-panel-budget">{{#each budgets}}<button type="button" data-action="spend" data-category="{{category}}" aria-label="Spend {{label}}" {{#if disabled}}disabled{{/if}}><strong>{{value}}</strong>{{label}}</button>{{/each}}</div><div class="hol-tool-actions"><button type="button" data-action="convert" data-from="main" data-to="maneuver" {{#if noMain}}disabled{{/if}}>Main → Maneuver</button><button type="button" data-action="convert" data-from="maneuver" data-to="movement" {{#if noManeuver}}disabled{{/if}}>Maneuver → Move</button><button type="button" data-action="finish" class="hol-primary">Finish turn</button></div>{{#if budget.movementBreakdown}}<p class="hol-tool-help">{{budget.movementBreakdown}}</p>{{/if}}{{/if}}<p class="hol-tool-help">Native encounter · changes are recorded on this encounter. Token, roster and encounter controls remain in the combat tracker.</p>
</div></section>
