<section class="hol-tool-shell"><header class="hol-banner"><p class="hol-kicker">Crafting</p><h1>{{name}}</h1><button type="button" data-action="refresh">Refresh projects</button></header><div class="hol-tool-content">{{#if pending}}<p role="status">An attempt is awaiting completion. {{#if canResume}}<button type="button" data-action="resume" {{#unless owned}}disabled{{/unless}}>Apply saved result</button>{{else}}Its dice may already have rolled. Reconcile the original retained dice before continuing; no new roll will be made.{{#if gm}}<label>Original retained dice<input name="retainedCraftDice" placeholder="2, 4, 6"></label><button type="button" data-action="recover">Record original dice and apply</button>{{/if}}{{/if}}</p>{{/if}}<p class="hol-note">Use the printed tools, materials and time. Each roll immediately records 1 / 2 / 3 progress or supply steps; completed catalog products enter Inventory.</p>
{{#each recipes}}<section class="hol-craft-project" data-recipe="{{id}}"><h2><button type="button" data-action="reference" data-path="{{source.path}}">{{name}}</button></h2><p>{{attemptMinutes}} minutes per attempt · {{#if maximumDie}}Maximum d{{maximumDie}}{{else}}Target {{target}}{{/if}}</p>{{#if project}}<p>{{#if project.active}}In progress{{else}}Ready{{/if}} · Progress {{project.progress}} · Completed {{project.completed}} · Attempts {{project.attempts}}</p>{{/if}}
{{#if available}}{{#if project.active}}<label>Crafting ability<select name="ability">{{#each abilities}}<option value="{{id}}">{{name}} · {{attribute}}</option>{{/each}}</select></label>{{#if maximumDie}}<label>Supply<select name="supply"><option value="">New supply</option>{{#each supplies}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{#if die}}d{{die}}{{else}}Empty{{/if}}</option>{{/each}}</select></label>{{/if}}<label>Net Banes / Boons<input type="range" name="adjustment" min="-3" max="3" value="0" step="1" aria-label="Net crafting Banes or Boons"><span class="hol-adjustment-scale"><span>−3 Banes</span><span>0</span><span>+3 Boons</span></span></label><button type="button" data-action="attempt" class="hol-primary" {{#unless ../owned}}disabled{{/unless}}>Roll and apply attempt</button>{{else}}<button type="button" data-action="start" {{#unless ../owned}}disabled{{/unless}}>Start project</button>{{/if}}{{else}}<p>Learn the printed crafting ability to start this recipe.</p>{{/if}}</section>{{else}}<p>No known recipes.</p>{{/each}}</div></section>
