<section class="hol-tool-shell hol-approved-tool"><header class="hol-tool-banner"><h1>Wounds and scars</h1><small>{{name}}</small></header><div class="hol-tool-content">
<section class="hol-tool-box"><h2>New wound</h2>{{#if owner}}<div class="hol-tool-actions"><button type="button" data-action="record" class="hol-primary">Add wound</button></div>{{/if}}<div class="hol-wound-events" aria-label="Pending wounds">{{#each events}}<button type="button" data-action="select" data-event-id="{{eventId}}" {{#if selected}}aria-pressed="true"{{/if}}>Wound {{number}} · {{damageType}} · {{#if (eq status "awaiting-roll")}}Awaiting roll{{else}}{{#if (eq status "rolled")}}Ready to apply{{else}}{{#if (eq status "rolling")}}Waiting for result{{else}}Recorded{{/if}}{{/if}}{{/if}}</button>{{else}}<p>No pending wound events.</p>{{/each}}</div>
{{#if awaiting}}<p>{{selected.priorWounds}} prior wounds · retain the highest three wound dice.</p><div class="hol-wound-roll-fields"><label>Damage type<select name="damageType">{{#each selected.types}}<option value="{{this}}">{{this}}</option>{{/each}}</select></label>{{#if owner}}<button type="button" data-action="roll" class="hol-primary">Roll wound</button>{{/if}}</div>{{/if}}
{{#if rolling}}<p class="hol-tool-result" role="status">Waiting for this wound’s saved result. No additional roll will be made.</p>{{#if owner}}<details class="hol-wound-exception"><summary>Recover original wound dice</summary><p>Use the original retained dice if the roll was interrupted.</p><label>Original retained dice<input name="faces" placeholder="2, 4, 6"></label><label>Note (optional)<input name="recoveryReason"></label><button type="button" data-action="recover">Record original result</button></details>{{/if}}{{/if}}</section>
{{#if result}}<section class="hol-tool-box hol-wound-result" role="status"><h2><button type="button" data-action="details">{{result.injury}}</button></h2><p class="hol-tool-help">Wound result {{result.key}}</p><ul>{{#each consequences}}<li>{{this}}</li>{{else}}<li>Lasting scar; no mechanical penalty.</li>{{/each}}</ul><dl><dt>Remedy</dt><dd>{{result.remedy}}</dd>{{#if result.recoveryValue}}<dt>Recovery value</dt><dd>{{result.recoveryValue}}</dd>{{/if}}</dl>
{{#each skipped}}<p class="hol-tool-help">Skipped {{key}}: {{reason}}</p>{{/each}}
{{#if owner}}{{#if fear}}<label>Perceptible fear source<input name="fearSource"></label>{{/if}}<div class="hol-tool-actions"><button type="button" data-action="apply" class="hol-primary">Apply wound once</button></div>{{/if}}
{{#if owner}}{{#unless terminal}}<details class="hol-wound-exception"><summary>Injury does not fit this anatomy</summary><label>Anatomy note (optional)<input name="anatomyReason"></label><button type="button" data-action="skip">Use next applicable result</button></details>{{/unless}}{{/if}}<p class="hol-tool-help">Conditions apply once. The DA directs any immediate displacement and legal placement.</p></section>{{/if}}
<section class="hol-tool-box"><h2>Recorded wounds and scars</h2><p class="hol-tool-help">Treatment clears eligible effects. Scars permanently count toward future wound rolls.</p><div class="hol-wound-table-wrap"><table class="hol-tool-wounds"><thead><tr><th>Wound / scar</th><th>Active effects</th><th>Treatment</th><th>Progress</th><th>Apply healing</th></tr></thead><tbody>{{#each wounds}}<tr data-wound-event="{{eventId}}"><td><button type="button" data-action="details" data-event-id="{{eventId}}"><strong>{{injury}}</strong></button>{{#if key}}<small>Result {{key}}</small>{{/if}}{{#each displacements}}<p class="hol-tool-help">{{direction}} {{distance}} square(s): {{status}}. DA direction and legal placement required.</p>{{/each}}</td><td>{{effectSummary}}</td><td>{{remedy}}</td><td>{{#if recoveryValue}}{{recoveryProgress}} / {{recoveryValue}}{{else}}—{{/if}}</td><td>{{#if canTreat}}<label><span class="hol-wound-visually-hidden">Healing progress</span><select name="treatmentProgress" aria-label="Healing progress for {{injury}}"><option value="1">1 progress</option><option value="2" selected>2 progress</option><option value="3">3 progress</option></select></label><button type="button" data-action="treat">Apply healing</button>{{/if}}</td></tr>{{else}}<tr><td colspan="5">No applied wound records.</td></tr>{{/each}}</tbody></table></div></section>
</div></section>
