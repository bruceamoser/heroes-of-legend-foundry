<section class="hol-body"><header class="hol-banner"><h1>{{name}}</h1><p>Wounds and scars</p></header>
{{#each events}}<button type="button" data-action="select" data-event-id="{{eventId}}" {{#if selected}}aria-pressed="true"{{/if}}>Wound {{number}} · {{damageType}} {{status}}</button>{{else}}<p>No pending wound events.</p>{{/each}}
{{#if awaiting}}<p>Prior wounds: {{selected.priorWounds}}. Choose the eligible damage type; retain the highest three wound dice.</p><label>Damage type<select name="damageType">{{#each selected.types}}<option value="{{this}}">{{this}}</option>{{/each}}</select></label>{{#if owner}}<button type="button" data-action="roll">Roll this wound once</button>{{/if}}{{/if}}
{{#if rolling}}<p class="hol-note">This wound is awaiting a saved result. Do not reroll. If the original result cannot be recovered, the DA can explicitly record the adjudicated dice and reason.</p>{{#if gm}}<label>Recorded dice, separated by commas<input name="faces" placeholder="2, 4, 6"></label><label>Recovery reason<input name="recoveryReason"></label><button type="button" data-action="recover">Record recovered dice</button>{{/if}}{{/if}}
{{#if result}}<h2>{{result.key}} · {{result.injury}}</h2><ul>{{#each consequences}}<li>{{this}}</li>{{else}}<li>Lasting scar; no mechanical penalty.</li>{{/each}}</ul><p>Treatment / remedy: {{result.remedy}}{{#if result.recoveryValue}} · RV {{result.recoveryValue}}{{/if}}</p><p class="hol-note">Conditions apply once. Lasting movement and contextual modifiers are recorded; apply those modifiers manually until their integration is complete. Immediate displacement requires DA direction and placement.</p>
{{#each skipped}}<p>Skipped {{key}}: {{reason}}</p>{{/each}}
{{#if gm}}{{#unless terminal}}<label>Anatomy exception reason<input name="anatomyReason"></label><button type="button" data-action="skip">This injury does not apply — next result</button>{{/unless}}{{#if fear}}<label>Perceptible fear source<input name="fearSource"></label>{{/if}}<button type="button" data-action="apply" class="hol-primary">Apply wound once</button>{{/if}}{{/if}}
<h2>Recorded wounds and scars</h2>{{#each wounds}}<article><h3>{{key}} · {{injury}}</h3><p>{{remedy}}{{#if recoveryValue}} · Recovery {{recoveryProgress}} / {{recoveryValue}}{{/if}}</p>{{#each displacements}}<p class="hol-note">{{direction}} {{distance}} square(s): {{status}}. DA direction and legal placement required.</p>{{/each}}</article>{{else}}<p>No applied wound records.</p>{{/each}}</section>
