<section class="hol-body"><header class="hol-banner"><h1>{{name}}</h1><p>Wounds and scars</p></header>{{#if owner}}<button type="button" data-action="record">Record additional wound</button>{{/if}}
{{#each events}}<button type="button" data-action="select" data-event-id="{{eventId}}" {{#if selected}}aria-pressed="true"{{/if}}>Wound {{number}} · {{damageType}} {{status}}</button>{{else}}<p>No pending wound events.</p>{{/each}}
{{#if awaiting}}<p>Prior wounds: {{selected.priorWounds}}. Choose the eligible damage type; retain the highest three wound dice.</p><label>Damage type<select name="damageType">{{#each selected.types}}<option value="{{this}}">{{this}}</option>{{/each}}</select></label>{{#if owner}}<button type="button" data-action="roll">Roll this wound once</button>{{/if}}{{/if}}
{{#if rolling}}<p class="hol-note">This wound is awaiting a saved result. Do not reroll. If the original result cannot be recovered, the DA can explicitly record the retained dice with an optional note.</p>{{#if gm}}<label>Recorded dice, separated by commas<input name="faces" placeholder="2, 4, 6"></label><label>Note (optional)<input name="recoveryReason"></label><button type="button" data-action="recover">Record recovered dice</button>{{/if}}{{/if}}
{{#if result}}<h2>{{result.key}} · {{result.injury}}</h2><ul>{{#each consequences}}<li>{{this}}</li>{{else}}<li>Lasting scar; no mechanical penalty.</li>{{/each}}</ul><p>Treatment / remedy: {{result.remedy}}{{#if result.recoveryValue}} · RV {{result.recoveryValue}}{{/if}}</p><p class="hol-note">Conditions apply once. Lasting movement and contextual modifiers contribute to normal preparation. Immediate displacement requires DA direction and placement.</p>
{{#each skipped}}<p>Skipped {{key}}: {{reason}}</p>{{/each}}
{{#if gm}}{{#unless terminal}}<label>Anatomy note (optional)<input name="anatomyReason"></label><button type="button" data-action="skip">This injury does not apply — next result</button>{{/unless}}{{/if}}{{#if owner}}{{#if fear}}<label>Perceptible fear source<input name="fearSource"></label>{{/if}}<button type="button" data-action="apply" class="hol-primary">Apply wound once</button>{{/if}}{{/if}}
<h2>Recorded wounds and scars</h2>{{#each wounds}}<article data-wound-event="{{eventId}}"><h3>{{key}} · {{injury}}</h3><p>{{remedy}}{{#if recoveryValue}} · Recovery {{recoveryProgress}} / {{recoveryValue}}{{/if}}</p>{{#if canTreat}}<label>Apply healing progress<select name="treatmentProgress"><option value="1">Weak · 1</option><option value="2" selected>Standard · 2</option><option value="3">Strong · 3</option></select></label><button type="button" data-action="treat">Apply healing</button>{{/if}}{{#each displacements}}<p class="hol-note">{{direction}} {{distance}} square(s): {{status}}. DA direction and legal placement required.</p>{{/each}}</article>{{else}}<p>No applied wound records.</p>{{/each}}</section>
