<section class="hol-library">
  <header><h2>Rules library</h2><label>Search rules and catalogs<input type="search" data-library-search></label><label>Collection<select data-library-collection><option value="all">All references</option><option value="design/rules/">Core rules</option><option value="design/player-book/">Player's Book</option><option value="design/cards/">Abilities</option><option value="design/equipment/">Equipment</option><option value="design/recipes/">Recipes</option>{{#if gm}}<option value="design/da-book/">Dungeon Architect's Guide</option><option value="design/bestiary/">Bestiary</option>{{/if}}</select></label>{{#if gm}}<button type="button" data-action="importRules">Import world journals</button>{{/if}}</header>
  <div class="hol-library-list">{{#each records}}<article data-library-entry data-path="{{path}}"><button type="button" data-action="openRule" data-path="{{path}}">{{name}}</button><small>{{path}}</small></article>{{/each}}</div>
</section>
