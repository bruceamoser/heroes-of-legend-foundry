    "import:wounds": "node scripts/import-wounds.mjs",
    "validate:wounds": "node scripts/import-wounds.mjs --check",
    "import:creature-art": "python3 scripts/build-creature-art.py",
    "validate:creature-art": "node scripts/validate-creature-art.mjs",
    "test:damage": "node scripts/check-damage.mjs",
    "test:recovery": "node scripts/check-recovery.mjs",
    "test:wounds": "node scripts/check-wounds.mjs",
    "test:survival": "node scripts/check-survival-turns.mjs",
    "test:condition-turns": "node scripts/check-condition-turns.mjs",
    "test:wound-context": "node scripts/check-wound-context.mjs",
    "test:summon-packs": "node scripts/check-summon-packs.mjs",
    "import:summon-packs": "node scripts/generate-content-packs.mjs",
    "validate:summon-packs": "node scripts/generate-content-packs.mjs --check",
    "test:compendium-portraits": "node scripts/check-compendium-portraits.mjs",
