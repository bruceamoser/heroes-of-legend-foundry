<section class="hol-body"><header class="hol-banner"><h1>{{name}}</h1><p>Condition sources</p></header>
<p>Each source retains its own rating and persistence. Temporary reductions do not remove starred or maintained effects.</p>
<ul>{{#each summary}}<li><strong>{{key}}</strong>: {{#if (eq kind "binary")}}active{{else}}{{rating}}{{/if}} · temporary {{temporary}}, persistent {{persistent}}</li>{{else}}<li>No active HOL conditions.</li>{{/each}}</ul>
{{#if gm}}<h2>Add a condition source</h2><div class="hol-pair"><label>Condition<select name="key">{{#each keys}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{key}}</option>{{/each}}</select></label><label>Rating<input name="rating" type="number" value="{{draft.rating}}" min="1" step="1" {{#if binary}}readonly{{/if}}></label></div>
<div class="hol-pair"><label>Persistence<select name="persistence">{{#each persistence}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label><label>Source or ruling<input name="source" type="text" value="{{draft.source}}"></label></div><button type="button" data-action="add">Add source</button>{{/if}}
<h2>Active sources</h2><ul class="hol-condition-sources">{{#each contributions}}<li><strong>{{key}} {{rating}}</strong> · {{persistence}}<p>{{source}}</p>{{#if ../gm}}{{#if temporary}}<button type="button" data-action="reduce" data-id="{{id}}">Reduce this temporary source by 1</button>{{/if}}<button type="button" data-action="remove" data-id="{{id}}">Remove this source</button>{{/if}}</li>{{else}}<li>No sources.</li>{{/each}}</ul>
</section>
