<section class="hol-library">
  <header><h2>Heroes of Legend · Rules</h2>{{#if gm}}<button type="button" data-action="importRules">Import two editable world books</button>{{/if}}</header>
  <div class="hol-library-layout"><aside class="hol-library-index"><label>Find rules<input type="search" data-library-search placeholder="Search full text…"></label><label>Collection<select data-library-collection><option value="all">All references</option><option value="design/rules/">Core rules</option><option value="design/player-book/">Player's Book</option><option value="design/cards/">Abilities</option><option value="design/equipment/">Equipment</option><option value="design/recipes/">Recipes</option>{{#if gm}}<option value="design/da-book/">Dungeon Architect's Guide</option><option value="design/bestiary/">Bestiary</option>{{/if}}</select></label>
    <nav class="hol-library-list" aria-label="Book contents">{{#each books}}<section data-library-book><h3>{{name}}</h3>{{#each sections}}<details open><summary>{{name}}</summary>{{#each records}}<article data-library-entry data-path="{{path}}"><button type="button" data-action="openRule" data-path="{{path}}">{{name}}</button></article>{{/each}}</details>{{/each}}</section>{{/each}}<p data-library-empty hidden>No matching entries.</p></nav>
  </aside><article class="hol-library-reader" data-library-reader aria-live="polite"><h2>At your table</h2><p>Choose a chapter or rule from the contents. References open here; use “Open full book” for the native journal with its table of contents, search and page navigation.</p></article></div>
</section>
