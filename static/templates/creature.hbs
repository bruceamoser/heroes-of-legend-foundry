<section class="hol-body hol-creature-sheet">
<header class="hol-banner">
<button type="button" class="hol-profile-portrait" data-action="viewPortrait" aria-label="View {{actor.name}} portrait"><img src="{{actor.img}}" alt="{{actor.name}}"></button>
<p class="hol-kicker">{{#if classification}}{{classification.category}} · {{/if}}Creature · CV {{system.cv}}</p>
<h1>{{actor.name}}</h1>
{{#if family}}<p>{{family}}</p>{{/if}}
</header>

{{#if automationLabel}}<p class="hol-note hol-creature-automation"><strong>Automation:</strong> {{automationLabel}}.</p>{{/if}}
<div class="hol-creature-actions" role="group" aria-label="Creature controls">
<button type="button" data-action="conditions">Condition sources</button>
{{#if gm}}<button type="button" data-action="damage">Apply damage</button><button type="button" data-action="recovery">Health and recovery</button>{{/if}}
<button type="button" data-action="equipment">Hands, worn gear and equipment</button>
</div>

<section class="hol-creature-summary" aria-labelledby="hol-creature-defenses-heading">
<h2 id="hol-creature-defenses-heading">Printed defenses</h2>
<dl class="hol-stat-grid">
<div><dt>HP</dt><dd>{{system.health.value}} / {{system.health.max}}</dd></div>
<div><dt>CV</dt><dd>{{system.cv}}</dd></div>
<div><dt>Speed</dt><dd>{{system.speed}}{{#each alternateSpeeds}} · {{mode}} {{value}}{{/each}}</dd></div>
<div><dt>Size</dt><dd>{{system.size}}{{#if system.sizeLabel}} · {{system.sizeLabel}}{{/if}}</dd></div>
<div><dt>Armor DR</dt><dd>{{system.armor}}{{system.armorMarker}}</dd></div>
<div><dt>Stability</dt><dd>{{system.stability}}</dd></div>
<div><dt>Evasion</dt><dd>{{evasionLabel}}</dd></div>
<div><dt>Threat</dt><dd>{{threatLabel}}</dd></div>
</dl>

<div class="hol-creature-mitigations">
<section>
<h3>Weaknesses</h3>
{{#if system.weaknesses.sourceText}}<p class="hol-source-text">{{system.weaknesses.sourceText}}</p>{{/if}}
{{#if system.weaknesses.numeric.length}}<ul>{{#each system.weaknesses.numeric}}<li>{{type}} {{value}}</li>{{/each}}</ul>{{else}}<p>None numeric.</p>{{/if}}
{{#if system.weaknesses.special.length}}<ul>{{#each system.weaknesses.special}}<li>{{type}} — {{reference}}</li>{{/each}}</ul>{{/if}}
</section>
<section>
<h3>Resistances</h3>
{{#if system.resistances.sourceText}}<p class="hol-source-text">{{system.resistances.sourceText}}</p>{{/if}}
{{#if system.resistances.numeric.length}}<ul>{{#each system.resistances.numeric}}<li>{{type}} {{value}}</li>{{/each}}</ul>{{else}}<p>None numeric.</p>{{/if}}
{{#if system.resistances.special.length}}<ul>{{#each system.resistances.special}}<li>{{type}} — {{reference}}</li>{{/each}}</ul>{{/if}}
</section>
<section>
<h3>Immunities</h3>
{{#if system.immunities.length}}<ul>{{#each system.immunities}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p>None.</p>{{/if}}
</section>
</div>
</section>

<section class="hol-creature-melee" aria-labelledby="hol-creature-melee-heading">
<h2 id="hol-creature-melee-heading">Basic Melee · player-defense orientation</h2>
<dl class="hol-outcome-grid">
<div><dt>Weak defense</dt><dd>{{system.basicMelee.weak}}</dd></div>
<div><dt>Standard defense</dt><dd>{{system.basicMelee.standard}}</dd></div>
<div><dt>Strong defense</dt><dd>{{system.basicMelee.strong}}</dd></div>
</dl>
<p>Requires {{system.basicMelee.defenseAttribute}} defense. The declared NPC attack and Defend workflows use this exact printed profile.</p>
{{#if gm}}
<div class="hol-pair hol-creature-melee-declare">
<label>DA blockable judgment<select data-npc-blockable><option value="">Choose explicitly</option><option value="true">Blockable</option><option value="false">Not blockable</option></select></label>
<button type="button" data-action="npcMelee">Declare NPC Basic Melee</button>
</div>
{{/if}}
</section>

{{#if referenceHTML}}
<section class="hol-creature-reference" aria-labelledby="hol-creature-reference-heading">
<div class="hol-reference-titlebar"><h2 id="hol-creature-reference-heading">Actions and details</h2><span class="hol-reference-badge">Read-only source reference</span></div>
<div class="hol-item-reference">{{{referenceHTML}}}</div>
<p class="hol-note">Specialty actions and exceptions are displayed from the pinned source. Their native automation is pending; this profile does not activate unverified effects.</p>
</section>
{{/if}}

<details class="hol-creature-editor" open>
<summary>Editable native profile</summary>
<fieldset {{#unless editable}}disabled{{/unless}}>
<label>Name<input name="name" value="{{actor.name}}"></label>
<div class="hol-attributes">{{#each attributes}}<label>{{label}}<input name="system.attributes.{{key}}.base" type="number" min="-2" max="2" step="1" value="{{base}}"><button type="button" data-action="rollAttribute" data-attribute="{{key}}">Roll {{label}}</button></label>{{/each}}</div>
<div class="hol-pair">
<label>Current HP<input name="system.health.value" type="number" min="0" step="1" value="{{system.health.value}}"></label>
<label>Maximum HP<input name="system.health.baseMax" type="number" min="1" step="1" value="{{system.health.baseMax}}"></label>
<label>CV<input name="system.cv" type="number" step="1" value="{{system.cv}}"></label>
<label>Printed Speed<input name="system.speed" type="number" min="0" step="1" value="{{system.speed}}"></label>
<label>Size (squares per side)<input name="system.size" type="number" min="1" step="1" value="{{system.size}}"></label>
<label>Armor DR (Physical resistance)<input name="system.armor" type="number" min="0" max="3" step="1" value="{{system.armor}}"></label>
<label>Stability<input name="system.stability" type="number" min="0" max="3" step="1" value="{{system.stability}}"></label>
</div>
<h2>Evasion · modifier to incoming player attacks</h2><div class="hol-pair"><label>Boons<input name="system.evasion.boons" type="number" min="0" step="1" value="{{system.evasion.boons}}"></label><label>Banes<input name="system.evasion.banes" type="number" min="0" step="1" value="{{system.evasion.banes}}"></label></div>
<h2>Threat · modifier to player defenses</h2><div class="hol-pair"><label>Boons<input name="system.threat.boons" type="number" min="0" step="1" value="{{system.threat.boons}}"></label><label>Banes<input name="system.threat.banes" type="number" min="0" step="1" value="{{system.threat.banes}}"></label></div>
<h2>Basic Melee · physical damage by defense result</h2><div class="hol-attributes"><label>Weak defense<input name="system.basicMelee.weak" type="number" min="0" step="1" value="{{system.basicMelee.weak}}"></label><label>Standard defense<input name="system.basicMelee.standard" type="number" min="0" step="1" value="{{system.basicMelee.standard}}"></label><label>Strong defense<input name="system.basicMelee.strong" type="number" min="0" step="1" value="{{system.basicMelee.strong}}"></label></div>
<label>Notes<textarea name="system.biography" rows="4">{{system.biography}}</textarea></label>
{{#if editable}}<button type="submit" class="hol-primary">Save changes</button>{{/if}}
</fieldset>
</details>

<h2>Abilities</h2><ul class="hol-ability-list">{{#each abilities}}<li><button type="button" data-action="openAbility" data-item-id="{{id}}">{{name}}</button></li>{{else}}<li>No ability Items.</li>{{/each}}</ul>
{{#if sourceLink}}<p class="hol-reference-source">Source: <a href="{{sourceLink}}" target="_blank" rel="noopener">{{sourcePath}}</a> at <code>{{sourceCommit}}</code>.</p>{{/if}}
</section>
