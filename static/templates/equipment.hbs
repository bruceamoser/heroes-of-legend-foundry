<section class="hol-body"><header class="hol-banner"><h1>{{item.name}}</h1></header><fieldset {{#unless editable}}disabled{{/unless}}>
<label>Name<input name="name" value="{{item.name}}"></label><div class="hol-pair"><label>Quantity<input type="number" name="system.quantity" min="1" step="1" value="{{system.quantity}}"></label><label>Bulk per item<input type="number" name="system.bulk" min="0" step="1" value="{{system.bulk}}"></label><label>Hands required<input type="number" name="system.hands" {{#if owned}}readonly{{/if}} min="0" max="2" step="1" value="{{system.hands}}"></label><label>Supply die (0: no supply)<input type="number" name="system.inventoryDie" min="0" max="20" step="1" value="{{system.inventoryDie}}"></label></div>{{#if owned}}<button type="button" data-action="hands">Equipment arrangement</button>{{/if}}{{#if canCheckSupply}}<p class="hol-note">After the DA approves a use, check this item’s supply. This changes only the supply die.</p><button type="button" data-action="supply">Check supply after use</button>{{else}}{{#if supplyOut}}<p class="hol-note">This item’s supply is out.</p>{{/if}}{{/if}}<label>Description<textarea name="system.description" rows="4">{{system.description}}</textarea></label>{{#if editable}}<button type="submit" class="hol-primary">Save changes</button>{{/if}}</fieldset></section>
