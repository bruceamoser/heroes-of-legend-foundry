<section class="hol-character-sheet">
  <header class="hol-character-header"><div class="hol-character-heading"><div class="hol-portrait-space" data-hol-portrait><img data-portrait-image src="{{actor.img}}" alt="{{actor.name}} portrait" role="button" tabindex="0" {{#if editable}}data-action="editImage" data-edit="img" title="Change portrait with Foundry's image browser, then Save portrait" aria-label="Change {{actor.name}} portrait"{{else}}data-action="viewPortrait" title="View portrait" aria-label="View {{actor.name}} portrait"{{/if}}><div class="hol-portrait-controls"><button type="button" data-action="viewPortrait" title="View full portrait">View</button>{{#if editable}}<button type="button" data-action="savePortrait" title="Save the selected portrait image">Save portrait</button>{{/if}}</div></div><div class="hol-character-heading-copy">
    <div class="hol-character-title">{{#if owned}}<button type="button" data-action="toggleEdit" class="hol-edit-toggle" aria-pressed="{{editMode}}"><i class="fa-solid fa-pen" aria-hidden="true"></i> {{#if editMode}}Done{{else}}Edit{{/if}}</button>{{/if}}<h1>{{actor.name}}</h1><span>Level {{level}} ({{dp}} DP)</span></div>
    <p class="hol-character-origin">{{identity}}</p>
    <div class="hol-character-vitals">
      <button type="button" data-action="recovery" title="Health and recovery"><strong>{{system.health.value}} / {{system.health.max}}</strong><span>HP</span></button>
      <button type="button" data-action="spendGrit" title="Spend Grit"><strong>{{system.grit.available}}</strong><span>Grit</span></button>
      <button type="button" data-action="wounds"><strong>{{wounds.length}}</strong><span>Wounds</span></button>
      <div class="hol-death-marks" aria-label="Death marks">{{#each marks}}<button type="button" data-action="death" class="{{#if filled}}is-filled{{/if}}" title="Death roll · {{value}} marks"><i class="fa-solid fa-skull" aria-hidden="true"></i><span class="sr-only">Death roll</span></button>{{/each}}</div>
      <small>Speed {{#if movement}}{{movement.speed}}{{else}}—{{/if}} · {{survivalStatus}}{{#if dyingDue}} · Death roll due{{/if}}</small>
    </div>
    </div></div><div class="hol-character-attributes">{{#each attributes}}<button type="button" data-action="rollAttribute" data-attribute="{{key}}" title="Roll {{label}}"><span>{{label}}</span><strong>{{effective}}</strong></button>{{/each}}</div>
  </header>
  <div class="hol-character-frame">
    <nav class="hol-character-tabs" aria-label="Character sheet">{{#each tabs}}<button type="button" data-action="switchTab" data-tab="{{id}}" title="{{label}}" aria-label="{{label}}" {{#if active}}aria-current="page"{{/if}}><i class="fa-solid {{icon}}" aria-hidden="true"></i><span>{{label}}</span></button>{{/each}}</nav>
    <main class="hol-character-content">
      <section data-tab-pane="main" {{#unless mainTab}}hidden{{/unless}}>{{#unless created}}{{#if owned}}<button type="button" data-action="createHero">Create or resume character</button>{{/if}}{{/unless}}
        <details data-disclosure="favorites" open><summary>Favorites</summary><ul class="hol-compact-list">{{#each favorites}}<li data-item-id="{{id}}" class="draggable"><button type="button" data-action="openAbility">{{name}}</button>{{#if ../owned}}<button type="button" data-action="useItem">Use</button><button type="button" data-action="favorite" aria-label="Unfavorite {{name}}" class="hol-star is-favorite">★</button>{{/if}}</li>{{else}}<li>Star abilities or inventory items to keep them here.</li>{{/each}}</ul></details>
        <div class="hol-character-summary">
          <details data-disclosure="defenses" open><summary>Defenses</summary><dl><dt>Resistance</dt><dd>{{#each resistances}}{{#unless @first}} · {{/unless}}{{type}} {{value}}{{else}}None{{/each}}</dd><dt>Weakness</dt><dd>{{#each weaknesses}}{{#unless @first}} · {{/unless}}{{type}} {{value}}{{else}}None{{/each}}</dd></dl><button type="button" data-action="evade">Evade</button>{{#if gm}}<button type="button" data-action="damage">Apply damage</button>{{/if}}{{#if owned}}<button type="button" data-action="recovery">Healing and safe breath</button>{{/if}}</details>
          <details data-disclosure="conditions" open><summary>Conditions</summary><ul>{{#each conditionsList}}<li>{{key}} {{rating}}</li>{{else}}<li>None</li>{{/each}}</ul><button type="button" data-action="conditions">Manage conditions</button></details>
        </div>
        {{#each actionGroups}}<details data-disclosure="actions-{{key}}" open><summary>{{label}}</summary><ul class="hol-compact-list">{{#each entries}}<li class="draggable" data-item-id="{{id}}"><span class="hol-timing">{{timing}}</span><span class="hol-discipline-marks">{{#each requirements}}<span title="{{name}} {{rank}}"><img src="{{mark}}" alt="{{name}} {{rank}}">{{#if ranked}}<b>{{rank}}</b>{{/if}}</span>{{/each}}</span><button type="button" data-action="openAbility">{{name}}</button>{{#if ../../editMode}}{{#if basic}}<button type="button" data-action="basicVisibility" data-visible="{{shown}}" aria-pressed="{{shown}}">{{#if shown}}Hide{{else}}Show{{/if}}</button>{{/if}}{{/if}}{{#if ../../owned}}<button type="button" data-action="useItem">Use</button><button type="button" class="hol-star {{#if favorite}}is-favorite{{/if}}" data-action="favorite" aria-label="Favorite {{name}}" aria-pressed="{{favorite}}">{{#if favorite}}★{{else}}☆{{/if}}</button>{{/if}}</li>{{else}}<li>None</li>{{/each}}</ul></details>{{/each}}
        <details data-disclosure="supplies" open><summary>Supplies</summary><ul class="hol-compact-list">{{#each equipmentRows}}{{#if hasSupply}}<li data-item-id="{{id}}"><button type="button" data-action="openAbility">{{name}}</button><span>{{supplyLabel}}</span>{{#if ../owned}}<button type="button" data-action="supply">Supply check</button><button type="button" data-action="resupply">Resupply</button>{{/if}}</li>{{/if}}{{/each}}</ul></details>
      </section>
      <section data-tab-pane="character" {{#unless characterTab}}hidden{{/unless}}>
        <details data-disclosure="story" open><summary>Story</summary><label>{{localize "HOL.Biography"}}<textarea name="system.biography" rows="5" {{#unless owned}}disabled{{/unless}}>{{system.biography}}</textarea></label><label>Message by Heart (up to 50 words)<textarea name="system.memorizedMessage" rows="3" maxlength="5000" {{#unless owned}}disabled{{/unless}}>{{system.memorizedMessage}}</textarea></label>{{#if owned}}<button type="button" data-action="saveStory">Save story</button>{{/if}}</details>
        <details data-disclosure="wounds" open><summary>Wounds and scars</summary><ul>{{#each wounds}}<li><strong>{{injury}}</strong>{{#if key}} · {{key}}{{/if}}{{#if recoveryValue}} · {{capability}} · Recovery {{recoveryProgress}} / {{recoveryValue}}{{/if}}{{#if remedy}}<small>{{remedy}}</small>{{/if}}</li>{{else}}<li>No recorded wounds.</li>{{/each}}</ul><button type="button" data-action="wounds">Wound rolls and details</button></details>
        <details data-disclosure="languages" open><summary>Languages and specialties</summary><ul>{{#each development.languages}}<li>{{name}} · {{form}}{{#if permissions.read}} · read and write{{/if}}</li>{{/each}}{{#each development.specialties}}<li>A Party Piece: {{specialty}}</li>{{/each}}</ul></details>
        {{#if editMode}}<fieldset {{#unless editable}}disabled{{/unless}}><legend>Character values</legend><label>Name<input name="name" type="text" value="{{actor.name}}" required></label><div class="hol-attributes">{{#each attributes}}<label>{{label}}<input name="system.attributes.{{key}}.base" type="number" value="{{base}}" min="-2" max="2" step="1" required></label>{{/each}}</div><p>Attribute total {{system.attributeTotal}} / +3</p><div class="hol-pair"><label>Current HP<input name="system.health.value" type="number" min="0" value="{{system.health.value}}"></label><label>Base maximum HP<input name="system.health.baseMax" type="number" min="1" value="{{system.health.baseMax}}"></label><label>Granted Grit<input name="system.grit.granted" type="number" min="0" value="{{system.grit.granted}}"></label><label>Spent Grit<input name="system.grit.spent" type="number" min="0" value="{{system.grit.spent}}"></label></div><button type="submit">Save values</button></fieldset>{{/if}}
      </section>
      <section data-tab-pane="abilities" {{#unless abilitiesTab}}hidden{{/unless}}><h2>Abilities</h2><ul class="hol-compact-list">{{#each abilityRows}}<li class="draggable" data-item-id="{{id}}"><span class="hol-timing">{{timing}}</span><span class="hol-discipline-marks">{{#each requirements}}<span title="{{name}} {{rank}}"><img src="{{mark}}" alt="{{name}} {{rank}}">{{#if ranked}}<b>{{rank}}</b>{{/if}}</span>{{/each}}</span><button type="button" data-action="openAbility">{{name}}</button>{{#if ../owned}}<button type="button" data-action="useItem">Use</button><button type="button" data-action="postReference" title="Post {{name}} to chat"><i class="fa-solid fa-comment" aria-hidden="true"></i><span class="sr-only">Post to chat</span></button><button type="button" class="hol-star {{#if favorite}}is-favorite{{/if}}" data-action="favorite" aria-label="Favorite {{name}}" aria-pressed="{{favorite}}">{{#if favorite}}★{{else}}☆{{/if}}</button>{{/if}}</li>{{else}}<li>No learned abilities.</li>{{/each}}</ul></section>
      <section data-tab-pane="inventory" {{#unless inventoryTab}}hidden{{/unless}}><div class="hol-section-heading"><h2>Inventory</h2>{{#if owned}}<button type="button" data-action="addEquipment">Add equipment</button>{{/if}}</div><p>{{bulk}} Bulk · Capacity {{#if movement}}{{movement.capacity}}{{else}}{{development.creationSummary.capacity}}{{/if}} · {{development.coins}} coins</p><button type="button" data-action="equipment">Equip, remove and arrange hands</button><ul class="hol-compact-list">{{#each equipmentRows}}<li class="draggable hol-inventory-row" data-item-id="{{id}}"><button type="button" data-action="openAbility"><strong>{{name}}</strong><small>{{arrangement}} · {{bulk}} Bulk</small></button><label class="hol-quantity">Qty<input type="number" min="0" step="1" data-quantity="{{id}}" value="{{system.quantity}}" {{#unless ../owned}}disabled{{/unless}}></label>{{#if hasSupply}}<span>{{supplyLabel}}</span>{{#if ../owned}}<button type="button" data-action="supply" title="Supply check">🎲</button><button type="button" data-action="resupply" title="Resupply one step">+</button>{{/if}}{{/if}}{{#if ../owned}}<button type="button" class="hol-star {{#if favorite}}is-favorite{{/if}}" data-action="favorite" aria-label="Favorite {{name}}" aria-pressed="{{favorite}}">{{#if favorite}}★{{else}}☆{{/if}}</button>{{/if}}</li>{{else}}<li>No equipment.</li>{{/each}}</ul></section>
      <section data-tab-pane="development" {{#unless developmentTab}}hidden{{/unless}}><div class="hol-section-heading"><h2>Development</h2>{{#if owned}}{{#if created}}<button type="button" data-action="advanceHero">Develop character</button>{{else}}<button type="button" data-action="createHero">Create or resume character</button>{{/if}}{{/if}}</div><details data-disclosure="training" open><summary>Training</summary><p>Level {{level}} · {{dp}} DP</p><ul>{{#each ranks}}<li>{{name}} {{rank}}</li>{{else}}<li>No discipline ranks.</li>{{/each}}</ul></details><details data-disclosure="signatures" open><summary>Class signatures</summary><ul>{{#each signatures}}<li>{{name}}</li>{{else}}<li>No learned class signatures.</li>{{/each}}</ul><button type="button" data-action="advanceHero">Review signatures</button></details><details data-disclosure="advancement" open><summary>Advancement history</summary><ul>{{#each purchases}}<li>{{name}} · Level {{level}}{{#if rank}} · Rank {{rank}}{{/if}}</li>{{else}}<li>No advancement purchases.</li>{{/each}}</ul></details><details data-disclosure="ledger"><summary>Creation ledger</summary><ul>{{#each ledger}}<li>{{label}}{{#if sourceName}} · {{sourceName}}{{/if}} · {{delta}} DP · Balance {{balance}}</li>{{else}}<li>No committed creation ledger.</li>{{/each}}</ul></details></section>
      <section data-tab-pane="crafting" {{#unless craftingTab}}hidden{{/unless}}><div class="hol-section-heading"><h2>Crafting</h2><button type="button" data-action="crafting">Projects and recipe rolls</button></div><ul>{{#each recipes}}<li>{{name}}</li>{{else}}<li>No known recipes.</li>{{/each}}</ul></section>
    </main>
  </div>
</section>
