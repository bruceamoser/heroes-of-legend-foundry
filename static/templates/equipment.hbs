<section class="hol-body hol-native-card hol-item-card"><div class="hol-card-fixed"><div class="hol-card-toolbar">{{#if editable}}<button type="button" data-action="cardEdit">{{#if cardEditing}}✓ Done{{else}}✎ Edit{{/if}}</button>{{/if}}</div><header class="hol-banner"><img class="hol-item-mark" src="{{cardMark}}" alt=""><h1>{{item.name}}</h1></header><dl class="hol-card-item-stats"><div><dt>Quantity</dt><dd>{{system.quantity}}</dd></div><div><dt>Bulk</dt><dd>{{system.bulk}}</dd></div><div><dt>Hands</dt><dd>{{system.hands}}</dd></div><div><dt>Supply</dt><dd>{{#if system.inventoryDie}}d{{system.inventoryDie}}{{else}}—{{/if}}</dd></div></dl></div><div class="hol-card-scroll">
{{#if potion}}<p class="hol-note">Restore fixed HP, then check this bottle’s supply.</p><button type="button" class="hol-primary" data-action="usePotion">Use healing potion</button>{{/if}}
{{#if descriptionHTML}}<div class="hol-item-reference-output">{{{descriptionHTML}}}</div>{{/if}}
{{#if owned}}<button type="button" data-action="hands">Equipment arrangement</button>{{/if}}{{#if canCheckSupply}}<p class="hol-note">After the DA approves a use, check this item’s supply. This changes only the supply die.</p><button type="button" data-action="supply">Check supply after use</button>{{else}}{{#if supplyOut}}<p class="hol-note">This item’s supply is out.</p>{{/if}}{{/if}}{{#if canResupply}}<button type="button" data-action="resupply">Resupply one step</button>{{/if}}{{#if cardEditing}}<fieldset {{#unless editable}}disabled{{/unless}}>
<label>Name<input name="name" value="{{item.name}}"></label><div class="hol-pair"><label>Quantity<input type="number" name="system.quantity" min="0" step="1" value="{{system.quantity}}"></label><label>Bulk per item<input type="number" name="system.bulk" min="0" step="1" value="{{system.bulk}}"></label><label>Hands required<input type="number" name="system.hands" {{#if owned}}readonly{{/if}} min="0" max="2" step="1" value="{{system.hands}}"></label><label>Supply die (0: no supply)<input type="number" name="system.inventoryDie" min="0" max="20" step="1" value="{{system.inventoryDie}}"></label></div><label>Description<textarea name="system.description" rows="4">{{system.description}}</textarea></label>{{#if editable}}<button type="submit" class="hol-primary">Save changes</button>{{/if}}</fieldset>{{/if}}</div></section>
