<section class="hol-body"><header class="hol-banner"><h1>Automation coordinator</h1></header>
<p>Assigned GM: <strong>{{owner}}</strong>. {{#if selected}}{{#if uncertain}}This window is suspended for reconciliation.{{else}}This window processes requests.{{/if}}{{else}}This window is not processing requests.{{/if}}</p>
{{#if busy}}<p class="hol-note">A request is running or its checkpoint needs reconciliation.</p>{{/if}}
<p>Release the coordinator before moving to another GM window. Release waits for queued work to finish. An idle reload in the same browser can resume automatically; another live tab cannot take its lock.</p>
{{#if restartAvailable}}<label><input type="checkbox" name="restartConfirmed"> Former GM windows are closed and the world has been relaunched.</label>{{/if}}
<button type="button" data-action="activate">Enable or recover this window</button><button type="button" data-action="release" {{#unless canRelease}}disabled{{/unless}}>Finish queued work and release</button>
<h2>Pending survival turn phases</h2><ul>{{#each pendingTurns}}<li>{{name}}<button type="button" data-action="resumeTurn" data-id="{{id}}" data-combat="{{combatUuid}}">Resume turn phase</button><button type="button" data-action="cancelTurn" data-combat="{{combatUuid}}">Cancel unapplied turn change</button></li>{{else}}<li>No pending turn phases.</li>{{/each}}</ul>
<h2>Unsettled defense rolls</h2><ul>{{#each pendingDefenses}}<li>Attempt {{attempt}} · {{actorUuid}}<button type="button" data-action="retry" data-id="{{requestId}}">Resume saved result</button><button type="button" data-action="abandonDefense" data-attack="{{attackId}}" data-id="{{requestId}}">Abandon unknown result</button></li>{{else}}<li>No unsettled defense rolls.</li>{{/each}}</ul>
<h2>Pending inventory checks</h2><ul>{{#each pendingInventories}}<li>{{actorName}} · {{itemName}} · {{phase}}<button type="button" data-action="openInventory" data-actor="{{actorUuid}}" data-item="{{itemId}}">Review or recover check</button></li>{{else}}<li>No pending inventory checks.</li>{{/each}}</ul>
<h2>Pending player attacks</h2><ul>{{#each pendingAttacks}}<li>{{attacker}} → {{target}}{{#if saved}} · authoritative result retained{{else}} · unknown dice{{/if}}{{#unless sourceAvailable}} · presentation deleted; durable request retained{{/unless}} {{status}}<button type="button" data-action="resumeAttack" data-id="{{id}}" data-combat="{{combatUuid}}">Resume committed attack</button>{{#if recoverable}}<button type="button" data-action="recoverAttack" data-id="{{id}}">Recover retained dice</button>{{/if}}</li>{{else}}<li>No player attacks await continuation.</li>{{/each}}</ul>
<h2>Pending actions</h2><ul>{{#each pendingAbilities}}<li>{{name}} <button type="button" data-action="resumeAbility" data-id="{{id}}" data-combat="{{combatUuid}}">Resume reserved action</button></li>{{else}}<li>No reserved actions need continuation.</li>{{/each}}</ul>
<h2>Recent automation requests</h2><p>Retry uses the original author and receipts. It does not repeat completed grants.</p><ul>{{#each requests}}<li><strong>{{request}}</strong> · {{author}}<p>{{content}}</p><button type="button" data-action="retry" data-id="{{id}}">Review and retry request</button></li>{{else}}<li>No automation requests.</li>{{/each}}</ul></section>
