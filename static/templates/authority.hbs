<section class="hol-body"><header class="hol-banner"><h1>Interrupted actions</h1></header>
<p>Normal player actions resolve automatically. This panel is for a saved action interrupted by a lost connection or server shutdown, not DA approval.</p>
<h2>Saved interruptions</h2><ul>{{#each interrupted}}<li>{{id}} · {{target}}{{#if canRetry}}<button type="button" data-action="retry" data-id="{{id}}">Resume saved action</button>{{/if}}</li>{{else}}<li>No saved interruptions.</li>{{/each}}</ul>
<details><summary>Connection diagnostics</summary><p>Processing GM: <strong>{{owner}}</strong>. {{#if selected}}This window is connected.{{else}}Another window may be processing shared documents.{{/if}}</p><p>Reconnection after a world restart happens automatically. An interrupted action is isolated so unrelated play can continue.</p>
<button type="button" data-action="activate">Reconnect this window</button><button type="button" data-action="release" {{#unless canRelease}}disabled{{/unless}}>Finish work and disconnect this window</button></details>
<h2>Pending survival turn phases</h2><ul>{{#each pendingTurns}}<li>{{name}}<button type="button" data-action="resumeTurn" data-id="{{id}}" data-combat="{{combatUuid}}">Resume turn phase</button><button type="button" data-action="cancelTurn" data-combat="{{combatUuid}}">Cancel unapplied turn change</button></li>{{else}}<li>No pending turn phases.</li>{{/each}}</ul>
<h2>Unsettled defense rolls</h2><ul>{{#each pendingDefenses}}<li>Attempt {{attempt}} · {{actorUuid}}<button type="button" data-action="retry" data-id="{{requestId}}">Resume saved result</button><button type="button" data-action="abandonDefense" data-attack="{{attackId}}" data-id="{{requestId}}">Abandon unknown result</button></li>{{else}}<li>No unsettled defense rolls.</li>{{/each}}</ul>
<h2>Pending inventory checks</h2><ul>{{#each pendingInventories}}<li>{{actorName}} · {{itemName}} · {{phase}}<button type="button" data-action="openInventory" data-actor="{{actorUuid}}" data-item="{{itemId}}">Review or recover check</button></li>{{else}}<li>No pending inventory checks.</li>{{/each}}</ul>
<h2>Pending player attacks</h2><ul>{{#each pendingAttacks}}<li>{{attacker}} → {{target}}{{#if saved}} · authoritative result retained{{else}} · unknown dice{{/if}}{{#unless sourceAvailable}} · presentation deleted; durable request retained{{/unless}}{{#if acknowledged}} · missing presentation acknowledged{{/if}} {{status}}{{#if sourceAvailable}}<button type="button" data-action="resumeAttack" data-id="{{id}}" data-combat="{{combatUuid}}">Resume committed attack</button>{{else if reconcileAvailable}}<button type="button" data-action="resumeAttack" data-id="{{id}}" data-combat="{{combatUuid}}">Reconcile durable result</button>{{else if canAcknowledge}}<button type="button" data-action="acknowledgeMissingAttack" data-id="{{id}}">Acknowledge missing presentation</button>{{/if}}{{#if recoverable}}<button type="button" data-action="recoverAttack" data-id="{{id}}">Recover retained dice</button>{{/if}}{{#if damageAvailable}}<button type="button" data-action="openAttackDamage" data-id="{{id}}">Review target damage by operation ID</button>{{/if}}</li>{{else}}<li>No player attacks await continuation.</li>{{/each}}</ul>
<h2>Pending actions</h2><ul>{{#each pendingAbilities}}<li>{{name}} <button type="button" data-action="resumeAbility" data-id="{{id}}" data-combat="{{combatUuid}}">Resume reserved action</button></li>{{else}}<li>No reserved actions need continuation.</li>{{/each}}</ul>
<h2>Pending healing potions</h2><ul>{{#each pendingPotions}}<li>{{giver}} → {{recipient}} · {{phase}}{{#if needsRecovery}}<button type="button" data-action="recoverPotion" data-id="{{requestId}}" data-combat="{{combatUuid}}">Record observed supply face</button>{{else}}{{#if needsReconciliation}}<button type="button" data-action="reconcilePotion" data-id="{{requestId}}" data-combat="{{combatUuid}}">Reconcile exact bottle</button>{{else}}<button type="button" data-action="resumePotion" data-id="{{requestId}}" data-combat="{{combatUuid}}">Resume potion from receipts</button>{{/if}}{{/if}}</li>{{else}}<li>No healing potion operations need continuation.</li>{{/each}}</ul>
<h2>Recent automation requests</h2><p>Retry uses the original author and receipts. It does not repeat completed grants.</p><ul>{{#each requests}}<li><strong>{{request}}</strong> · {{author}}<p>{{content}}</p><button type="button" data-action="retry" data-id="{{id}}">Review and retry request</button></li>{{else}}<li>No automation requests.</li>{{/each}}</ul></section>
