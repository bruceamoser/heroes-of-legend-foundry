<section class="hol-body"><header class="hol-banner"><h1>{{item.name}}</h1></header><fieldset {{#unless editable}}disabled{{/unless}}>
<label>Name<input name="name" value="{{item.name}}"></label><div class="hol-pair"><label>Quantity<input type="number" name="system.quantity" min="1" step="1" value="{{system.quantity}}"></label><label>Bulk per item<input type="number" name="system.bulk" min="0" step="1" value="{{system.bulk}}"></label><label>Hands in use<input type="number" name="system.hands" min="0" max="2" step="1" value="{{system.hands}}"></label><label>Inventory die (0: no supply)<input type="number" name="system.inventoryDie" min="0" max="20" step="1" value="{{system.inventoryDie}}"></label></div><label>Description<textarea name="system.description" rows="4">{{system.description}}</textarea></label>{{#if editable}}<button type="submit" class="hol-primary">Save changes</button>{{/if}}</fieldset></section>
