    "validate:creature-packs": "node scripts/generate-creature-packs.mjs --check",
    "import:inventory": "node scripts/import-inventory.mjs",
    "validate:inventory": "node scripts/import-inventory.mjs --check",
    "test:charactermancer": "node scripts/check-charactermancer.mjs",
    "test:creation": "node scripts/check-creation.mjs",
    "test:creation-commit": "node scripts/check-creation-commit.mjs",
    "test:languages": "node scripts/check-languages.mjs",
    "test:reference-heroes": "node scripts/check-reference-heroes.mjs",
    "test:advancement": "node scripts/check-advancement.mjs",
    "test:coordinator": "node scripts/check-coordinator.mjs",
    "test:coordinator-restart": "node scripts/check-coordinator-restart.mjs",
