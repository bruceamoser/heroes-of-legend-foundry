<section class="hol-roll-shell">
  <header class="hol-banner"><p class="hol-kicker">{{#if death}}Death roll{{else}}{{#if defense}}Defense{{else}}Attribute check{{/if}}{{/if}}</p><span class="hol-roll-context">{{name}}{{#if defense}} · Defense{{/if}}</span><h1>{{#if defense}}Defend{{#if incoming}} · {{incoming.title}}{{/if}}{{else}}{{#if death}}Death roll{{else}}Attribute check{{/if}}{{/if}}</h1></header>{{#if targetNotice}}<p class="hol-note">{{targetNotice}}</p>{{/if}}
  <div class="hol-body">
  {{#if notice}}<p class="hol-note" role="alert">{{notice}}</p>{{/if}}
  {{#if death}}<section class="hol-death-panel"><div class="hol-death-marks" role="group" aria-label="Death marks">{{#each deathMarks}}<button type="button" data-action="deathMark" data-marks="{{value}}" aria-label="Set {{value}} death marks" aria-pressed="{{filled}}" class="{{#if filled}}filled{{/if}}"><i class="fa-solid fa-skull" aria-hidden="true"></i></button>{{/each}}<strong>{{failed}} / 3</strong></div><div class="hol-death-outcomes"><span><b>Weak</b> +1 mark</span><span><b>Standard</b> No change</span><span><b>Strong</b> Stabilize</span></div></section>{{/if}}
  {{#if weaponOptions}}<label>Attack item<select name="weaponItemId">{{#each weaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
  {{#if rangedWeaponOptions}}<label>Ranged weapon<select name="rangedWeaponItemId">{{#each rangedWeaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
  <section class="hol-roll-setup"><div class="hol-roll-fields"><label>Attribute<select name="attributeKey" aria-label="Roll attribute" {{#unless attributeEditable}}disabled{{/unless}}>{{#each attributeOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Value<output data-roll-value>{{attribute}}</output></label></div>
  {{#if damageTypeOptions}}<label>Damage type<select name="damageType">{{#each damageTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
  {{#if defenseSubstitutions}}<label>Defense attribute (optional)
    <select name="defenseSubstitutionItemUuid">
      <option value="">Printed defense attribute · {{attributeName}}</option>
      {{#each defenseSubstitutions}}<option value="{{itemUuid}}" {{#if selected}}selected{{/if}}>{{name}} · {{attributeName}}{{#if boons}} · +{{boons}} Boon{{/if}}</option>{{/each}}
    </select>
  </label>
{{/if}}
  <div class="hol-net" data-net-control><label class="hol-net-heading"><span>Banes</span><output data-adjustment-label>{{adjustmentLabel}}</output><span>Boons</span></label><div class="hol-net-track"><span class="hol-net-fill"></span><input type="range" name="adjustment" min="-3" max="3" step="1" value="{{draft.adjustment}}" aria-label="Banes / Boons" aria-valuetext="{{adjustmentLabel}}"></div></div>
  <div class="hol-roll-pool" aria-live="polite"><div class="hol-pool-count"><strong data-roll-count>3</strong><span>d6</span></div><div class="hol-pool-detail"><div data-roll-dice class="hol-pool-dice" aria-hidden="true"></div><strong data-roll-keep>Keep all three</strong><code data-roll-formula></code></div></div></section>
  {{#if partyPiece}}<label><input type="checkbox" name="partyPiece" {{#if draft.partyPiece}}checked{{/if}}> A Party Piece · +1 Boon when entertaining through your chosen specialty (<a class="content-link" data-link data-type="Item" data-uuid="{{partyPiece}}">ability</a>)</label>{{/if}}
  {{#if lookOverHere}}<details class="hol-context-options"><summary>Ally assistance</summary><label><input type="checkbox" name="lookOverHere" {{#if draft.lookOverHere}}checked{{/if}}> Look Over Here! · +1 Boon if an ally spent their Reaction for this defense</label><p class="hol-note">Sight-dependent attack by an enemy adjacent to that ally who can see them. No cover, Hidden or canceled attack.</p></details>{{/if}}
  {{#if abilities}}<details class="hol-roll-abilities"><summary>Defense abilities</summary><ul class="hol-defense-abilities">{{#each abilities}}<li data-item-id="{{itemId}}" class="{{#unless available}}hol-unavailable{{/unless}}"><button type="button" data-action="useAbility" data-item-id="{{itemId}}" {{#unless available}}disabled{{/unless}}>{{#if active}}Remove {{else}}{{#if available}}Use {{/if}}{{/if}}{{name}}</button><span class="hol-ability-reason">{{reasonText}}</span></li>{{/each}}</ul></details>{{/if}}
  <p data-reference-drop-status role="status" aria-live="polite"></p>
  {{#if references}}<details class="hol-roll-abilities hol-reference-picker"><summary>Abilities</summary>
    <label>Find ability<input type="search" data-reference-search></label>
    <ul class="roll-abilities">{{#each references}}<li data-reference-row><label class="inline-toggle"><input type="checkbox" data-reference-id="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label></li>{{/each}}</ul>
  </details>{{/if}}
  {{#if fears}}<details class="hol-context-options"><summary>Fear context (optional)</summary>
  {{#each fears}}<label><input type="checkbox" name="fear-{{index}}" {{#if yes}}checked{{/if}}> Perceiving {{source}}</label>{{/each}}</details>{{/if}}
  {{#if wounds}}<details open class="hol-context-options hol-wound-adjustments"><summary>Wound modifiers</summary>

  {{#each wounds}}<label class="hol-wound-context" data-effect-id="{{effectId}}"><input type="checkbox" name="wound-{{index}}" {{#if applies}}checked{{/if}}> {{injury}} · {{amount}} {{#if (eq polarity "boon")}}Boon{{else}}Bane{{/if}} · {{printedContext}}</label>{{/each}}</details>{{/if}}
  <details class="hol-context-options" {{#if death}}hidden{{/if}}><summary>Roll details</summary><ul class="hol-roll-sources"></ul><p class="hol-roll-totals" aria-live="polite"></p></details>

  </div><footer class="hol-roll-footer">
  <span data-roll-error role="alert"></span>
  <button type="button" data-action="roll" class="hol-primary">{{localize "HOL.Roll"}}</button>
</footer></section>
