<section class="hol-tool-shell hol-approved-tool"><header class="hol-tool-banner"><strong>{{currentName}}</strong></header><div class="hol-tool-content"><div class="hol-combat-roster">{{#each participants}}<div class="hol-combat-row {{#if active}}active{{/if}}"><button type="button" class="hol-combat-portrait-button" data-action="actor" data-id="{{id}}" aria-label="Open {{name}}"><img class="hol-combat-portrait" src="{{img}}" alt=""></button><strong>{{name}}</strong>{{#if canChoose}}<button type="button" data-action="choose" data-id="{{id}}">Choose</button>{{/if}}{{#if active}}<span>Active</span>{{/if}}</div>{{else}}<p>No participants.</p>{{/each}}</div>{{#if canFinish}}<div class="hol-tool-actions"><button type="button" data-action="finish" class="hol-primary">Finish turn</button></div>{{/if}}</div></section>
