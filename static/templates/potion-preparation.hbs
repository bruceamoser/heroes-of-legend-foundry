<section class="hol-body hol-potion-preparation-body">
  <header class="hol-banner"><h1>Healing potion</h1></header>
  {{#unless bottlesAvailable}}<p class="hol-error">No healing bottle available.</p>{{else}}
  {{#if sourceIsBottle}}<p>{{selectedBottleName}}</p>{{else}}<label>Bottle<select name="bottleUuid">{{#each bottles}}<option value="{{uuid}}" {{#if (eq uuid ../selectedBottleUuid)}}selected{{/if}}>{{name}} · {{supply}}</option>{{/each}}</select></label>{{/if}}
  <p>Recipient: <strong data-preview="recipient-name">{{recipientName}}</strong><br><small>Target another token to offer it the potion; otherwise use it yourself.</small></p>
  <section class="hol-budget"><p data-preview="healing"></p><p><span data-preview="hands"></span> <span data-preview="reaction"></span></p></section>
  <section data-panel="willingness" hidden><p data-willing-prompt></p><label class="hol-check" data-willing-confirm><input type="checkbox" name="willing"> Willing recipient</label></section>
  <details><summary>Details</summary><p data-preview="supply"></p><p data-preview="conditions"></p><p data-preview="geometry-status"></p><p>Fixed healing applies Life resistance. Supply is checked after healing.</p></details>
  <details><summary>Interruption</summary><label>Outcome<select name="interruption"><option value="continue">Continue</option><option value="interrupted">Stopped before healing</option></select></label><p>An interruption can stop healing and the supply check.</p></details>
  {{#if gm}}<details data-panel="da-exceptions"><summary>Table exceptions</summary><label class="hol-check"><input name="daWillingness" type="checkbox"> Confirm willingness</label><label>Optional note<input name="daWillingnessReason" type="text"></label></details>{{/if}}
  <p class="hol-error" data-preview="error" aria-live="polite"></p>
  <button type="button" class="hol-primary" data-action="submit" disabled>Use potion</button>
  {{/unless}}
</section>
