<section class="hol-attack-card hol-chat-card" data-chat-kind="request"><header class="hol-chat-header">{{#if portrait}}<img src="{{portrait}}" alt="">{{/if}}<div><small>{{attackerName}} · Attack</small><h3>{{title}}</h3></div></header><div class="hol-chat-bar"><span>{{attributeKey}} defense</span><span>Threat {{threat.boons}} Boons / {{threat.banes}} Banes</span></div><div class="hol-chat-description">One adjacent creature · Physical damage</div>{{#if guidance}}<p>{{guidance}}</p>{{/if}}<table class="hol-chat-outcomes"><caption>Defense outcome</caption><thead><tr><th>Weak</th><th>Standard</th><th>Strong</th></tr></thead><tbody><tr><td>{{damage.weak}}</td><td>{{damage.standard}}</td><td>{{damage.strong}}</td></tr></tbody></table><footer class="hol-chat-footer"><span>Awaiting defense</span></footer><details class="hol-chat-details"><summary>Attack details</summary><p>{{#if hasBlockableJudgment}}{{#if blockable}}Usually blockable.{{else}}Usually not blockable.{{/if}}{{else}}Use a defense ability when the table considers it applicable.{{/if}} Roll defense, then use Apply Damage on the result when ready.</p></details></section>
