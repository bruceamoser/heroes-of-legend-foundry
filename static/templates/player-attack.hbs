<section class="hol-roll-shell">
<section class="hol-body">
  <header class="hol-banner">
    <p class="hol-kicker">Player attack · Main Action</p>
    <h1>{{actorName}} · Basic Melee</h1>
    <p>{{actorTokenName}}{{#if targetName}} → {{targetName}}{{/if}}</p>
  </header>
  {{#if notice}}<p class="hol-note" role="alert">{{notice}}</p>{{/if}}
  <div class="hol-pair">
    {{#if multipleWeapons}}<label>Weapon
      <select name="weaponItemUuid"><option value="">Choose a held weapon</option>
        {{#each weapons}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    </label>{{else}}<p>Weapon: <strong>{{weaponName}}</strong></p>{{/if}}
    <p class="hol-native-target" data-target-uuid="{{targetTokenUuid}}" aria-live="polite">Target: <strong>{{#if targetName}}{{targetName}}{{else}}Use Foundry targeting to select one adjacent creature.{{/if}}</strong></p>
  </div>
  <p>Brawn: <strong>{{attribute}}</strong></p>
  {{#if geometryReason}}<p class="hol-note" data-geometry-status="{{geometryStatus}}">{{geometryReason}}</p>{{/if}}
  {{#if reasons.length}}<section class="hol-errors" aria-live="polite"><ul>{{#each reasons}}<li>{{this}}</li>{{/each}}</ul></section>{{/if}}
  {{#if gm}}<details class="hol-context-options"><summary>Action budget exception (optional)</summary><label><input type="checkbox" name="override" {{#if override}}checked{{/if}}> Override the encounter action budget</label><label>Note (optional)<textarea name="rulingReason" rows="2">{{rulingReason}}</textarea></label></details>{{/if}}
  {{#if fears}}<details class="hol-context-options"><summary>Fear context (optional)</summary>
  {{#each fears}}<label><input type="checkbox" name="fear-{{index}}" {{#if yes}}checked{{/if}}> Perceiving {{source}}</label>{{/each}}</details>{{/if}}
  {{#if wounds}}<details class="hol-context-options"><summary>Wound adjustments (optional)</summary>
  <p>Apply a printed wound modifier when it fits this action.</p>
  {{#each wounds}}<label class="hol-wound-context" data-effect-id="{{effectId}}"><input type="checkbox" name="wound-{{index}}" {{#if applies}}checked{{/if}}> {{injury}} · {{amount}} {{#if (eq polarity "boon")}}Boon{{else}}Bane{{/if}} · {{printedContext}}</label>{{/each}}</details>{{/if}}
  <label class="hol-adjustment">Boons / Banes
    <span data-adjustment-label aria-live="polite">{{adjustmentLabel}}</span>
    <input type="range" name="adjustment" min="-3" max="3" step="1" value="{{draft.adjustment}}" aria-label="Boons or Banes" aria-valuetext="{{adjustmentLabel}}">
    <span class="hol-adjustment-scale" aria-hidden="true"><span>−3 Banes</span><span>0</span><span>+3 Boons</span></span>
  </label>
  <details class="hol-context-options"><summary>Roll details</summary>
  <ul class="hol-roll-sources">{{#each sources}}<li>{{label}}: {{amount}} {{kind}}{{#if automatic}} · automatic{{/if}}</li>{{/each}}</ul>
    <p class="hol-roll-totals" aria-live="polite">{{totals}}</p>
    <p>Physical damage: Weak 2 · Standard 3 · Strong 5.</p>
  </details>
</section>
<footer class="hol-roll-footer">
  <output aria-live="polite">{{formula}}</output>
  <button type="button" data-action="attack" class="hol-primary" {{#unless canAttack}}disabled{{/unless}}>Attack</button>
</footer>
</section>
