<section class="hol-wizard">
 <div class="hol-workshop-toolbar"><small>Character creation · draft saved automatically</small><div>{{#unless committed}}<button type="button" data-action="importCharacter">Import</button>{{/unless}}<button type="button" data-action="saveDraft">Save draft</button></div></div><header class="hol-workshop-hero"><div class="hol-workshop-identity"><img src="systems/heroes-of-legend/assets/marks/crest.webp" alt=""><div><div class="hol-wizard-name"><h1>{{draft.name}}</h1><button type="button" data-action="wizardDeath" class="hol-wizard-death" title="Death roll" aria-label="Death roll; {{vitals.failed}} failed"><i class="fa-solid fa-skull" aria-hidden="true"></i>{{#if vitals.failed}} {{vitals.failed}}{{/if}}</button></div><p>{{identityLine}} · Level {{characterLevel}}</p></div></div><div class="hol-workshop-vitals"><div><small>HP</small><strong class="hol-wizard-hp"><input data-wizard-hp aria-label="Current HP" type="number" min="0" max="{{vitals.max}}" step="1" value="{{vitals.hp}}"><span>/ {{vitals.max}}</span></strong></div><div><small><button type="button" data-action="wizardGrit" class="hol-wizard-vital-link">Grit</button></small><strong>{{vitals.grit}}</strong></div><div><small>Speed</small><strong>{{vitals.speed}}{{#if speedReduced}} / {{vitals.maxSpeed}}{{/if}}</strong></div><div><small><button type="button" data-action="wizardWounds" class="hol-wizard-vital-link">Wounds</button></small><strong>{{vitals.wounds.length}}</strong></div><div><small>Armor DR</small><strong>{{armorDr}}</strong></div></div></header><div class="hol-workshop-attributes">{{#each attributes}}<div><span>{{name}}</span><strong>{{signedValue}}</strong></div>{{/each}}</div>
 <div class="hol-wizard-layout">
 <nav aria-label="Creation steps">{{#each steps}}<button type="button" data-action="navigate" data-step="{{index}}" aria-label="{{name}}" title="{{name}}" {{#if active}}aria-current="step"{{/if}}>{{{icon}}}<span>{{name}}</span></button>{{/each}}</nav>
 <div class="hol-wizard-body">{{#if showContext}}<div class="hol-workshop-context">{{#if equipmentStep}}<span><strong>{{creationInventory.remainingCoins}}</strong> coins</span><span><strong>{{creationInventory.bulk}} / {{summary.capacity}}</strong> Bulk</span><span>Encumbrance <strong>{{creationEncumbrance}}</strong></span>{{else}}<strong>{{dp}} DP remaining</strong><span>Level {{stage}}</span><div class="hol-discipline-strip">{{#each knownRanks}}<span class="hol-discipline-chip"><img src="{{mark}}" alt="">{{name}} {{rank}}</span>{{/each}}</div>{{/if}}</div>{{/if}}<main class="hol-wizard-main">{{#unless review}}{{#if errors}}<details class="hol-validation"><summary>Choices still needed ({{errors.length}})</summary><ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul></details>{{/if}}{{/unless}}{{#if requiredChoices}}<aside class="hol-required-banner"><strong>Required choices</strong>{{#each requiredChoices}}<button type="button" data-required-choice="{{id}}">{{name}}</button>{{/each}}</aside>{{/if}}{{#if learningStep}}<div class="hol-section-heading"><h2>{{title}}</h2><div><button type="button" data-open-market="ability">Learn abilities</button>{{#if showDisciplineMarket}}<button type="button" data-open-market="discipline">Learn discipline</button>{{/if}}</div></div>{{else}}<h2>{{title}}</h2>{{/if}}
 {{#if identity}}
 <div class="hol-name-grid"><label>Character name<input name="heroName" value="{{draft.name}}"></label></div><h3 class="hol-section-title">Your attributes</h3>
 <p class="hol-inline-help">Assign −2 to +2 to each attribute, totaling +3. Each creation DP pool is 10 + Knowledge + Reason + Guile.</p>
 <div class="hol-attributes">{{#each attributes}}<label>{{name}}<input name="attribute-{{id}}" type="number" min="-2" max="2" step="1" value="{{value}}"></label>{{/each}}</div><div class="hol-assigned-total">Assigned total: <strong>{{signedAttributeTotal}} / +3</strong></div>
 {{/if}}
 {{#if ancestry}}
 <input type="hidden" name="ancestryId" value="{{draft.ancestryId}}"><div class="hol-workshop-cards">{{#each ancestries}}<article class="hol-workshop-choice {{#if selected}}is-selected{{/if}}"><h3>{{name}}</h3><p>+{{hp}} HP · Base speed {{speed}} · +{{coins}} coins</p><div class="hol-choice-actions"><button type="button" data-action="referenceChoice" data-id="{{id}}">Read rules</button><button type="button" data-action="chooseAncestry" data-id="{{id}}">{{#if selected}}Selected{{else}}Choose{{/if}}</button></div></article>{{/each}}</div>
 <fieldset class="hol-workshop-checks"><legend>Choose two traits</legend>{{#each traits}}<label><input type="checkbox" name="trait" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}{{#if stale}} <small>Earlier selection — remove to finish this step</small>{{/if}} <button type="button" data-action="referenceChoice" data-id="{{id}}">Read</button></label>{{/each}}</fieldset>
 {{#if ageOfMemory}}<label>Remembered community (Age of Memory)<input name="rememberedCommunity" value="{{draft.rememberedCommunity}}"></label>{{/if}}
 <label>Home language<select name="homeLanguage"><option value="">Choose a home language</option>{{#each languages}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>
 {{#if manyHomes}}<fieldset class="hol-language-choices" data-language-choice="extra"><legend>Two additional spoken languages</legend><p>These extra grants do not grant literacy or a signed language.</p>{{#each extraLanguages}}<label class="hol-choice hol-language-choice {{#unless eligible}}hol-ineligible{{/unless}} {{#if repair}}hol-repair{{/if}}" data-language-option="{{id}}"><input type="checkbox" name="extraLanguage" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}}> <strong>{{name}}</strong><small>{{summary}}</small>{{#if reason}}<small class="hol-error">{{reason}}</small>{{/if}}</label>{{/each}}</fieldset>{{/if}}
 {{/if}}
 {{#if origins}}<div class="hol-origin-grid">{{#each originCards}}<section class="hol-origin-card"><label>{{label}}<select name="{{kind}}"><option value="">Choose {{kind}} and grants</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{#if id}}<div class="hol-origin-grants"><button type="button" data-action="referenceChoice" data-id="{{id}}">{{name}}</button>{{#if disciplineId}}<span><img src="{{mark}}" alt="">{{discipline}} 1</span><button type="button" data-action="referenceChoice" data-id="{{abilityId}}">{{ability}}</button>{{/if}}</div>{{/if}}</section>{{/each}}</div><p class="hol-inline-help">Each selection grants the named discipline rank and ability. A duplicate grant adds 1 DP.</p>{{/if}}
 {{#if classStep}}
 <input type="hidden" name="classId" value="{{draft.classId}}"><div class="hol-workshop-cards">{{#each classes}}<article class="hol-workshop-choice {{#if selected}}is-selected{{/if}} {{#unless eligible}}hol-ineligible{{/unless}}"><h3>{{choice.name}}</h3><p>+{{choice.hp}} HP · +{{choice.coins}} coins</p><p>{{#if reasons}}{{reasons}}{{else}}You meet the requirements.{{/if}}</p><div class="hol-choice-actions"><button type="button" data-action="referenceChoice" data-id="{{choice.id}}">Read class</button><button type="button" data-action="chooseClass" data-id="{{choice.id}}" {{#unless eligible}}disabled{{/unless}}>{{#if selected}}Selected{{else}}Choose{{/if}}</button></div></article>{{/each}}</div>
 {{#if classSelected}}<fieldset class="hol-workshop-checks"><legend>Two starting disciplines</legend>{{#each classDisciplines}}<label><input type="checkbox" name="classDiscipline" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}}> {{name}}{{#if stale}} <small>Earlier selection — remove to finish this step</small>{{/if}} <button type="button" data-action="referenceChoice" data-id="{{id}}">Read</button></label>{{/each}}</fieldset>
 <input type="hidden" name="signatureId" value="{{draft.signatureId}}"><fieldset class="hol-workshop-cards"><legend>Your first signature</legend>{{#each signatures}}<article class="hol-workshop-choice {{#if selected}}is-selected{{/if}}"><h3>{{name}}</h3><p>{{reference.flavor.[0]}}</p><div class="hol-choice-actions"><button type="button" data-action="referenceChoice" data-id="{{id}}">Read signature</button><button type="button" data-action="chooseSignature" data-id="{{id}}">{{#if selected}}Selected{{else}}Choose{{/if}}</button></div></article>{{/each}}</fieldset>{{/if}}{{/if}}
 {{#if learningStep}}
 <section class="hol-build-box"><h3>Current Build</h3><table class="hol-build-table"><tbody>{{#each currentBuild}}<tr><td><button type="button" data-action="referenceChoice" data-id="{{id}}">{{name}}</button></td><td>{{grantSource}}{{#if locked}} · Locked{{/if}}</td><td>{{#if removable}}<button type="button" data-action="removePurchase" data-index="{{index}}">Remove</button>{{/if}}</td></tr>{{#if acquisition}}<tr><td colspan="3">{{#with acquisition}}<div class="hol-required-choice"><fieldset data-acquisition="{{id}}"><legend>{{name}}</legend>{{#if languageChoice}}<label>Ordinary language and normal script<select name="languageId-{{id}}"><option value="">Choose a language</option>{{#each languageOptions}}<option value="{{id}}" data-intrinsic-disabled="{{#if disabled}}true{{else}}false{{/if}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>{{/if}}{{#if specialtyChoice}}<label>Mundane performance specialty<input name="specialty-{{id}}" maxlength="120" value="{{specialty}}" placeholder="e.g. juggling or singing"></label>{{/if}}
 {{#if weaponOptions}}<label>Attack equipment<select name="weapon-{{id}}"><option value="">Choose equipment</option>{{#each weaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
 {{#if needsHands}}<label>Melee weapon hand use<select name="hands-{{id}}"><option value="">Choose if a weapon is granted</option>{{#each handOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}
 {{#if recipeChoices}}<div data-recipes><p>Choose {{recipeChoices}} ordinary recipes.</p>{{#each recipes}}<label><input type="checkbox" name="recipes-{{../id}}" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label>{{/each}}</div>{{/if}}</fieldset></div>{{/with}}</td></tr>{{/if}}{{/each}}{{#each disciplinePurchases}}<tr><td><button type="button" data-action="referenceChoice" data-id="{{id}}">{{name}}</button></td><td>Rank {{rank}}</td><td><button type="button" data-action="removePurchase" data-index="{{index}}">Remove</button></td></tr>{{/each}}</tbody></table></section>
 {{/if}}
 {{#if learningStep}}<dialog class="hol-learning-market" data-learning-market="learning"><header><h2 data-market-title>Learn abilities</h2><button type="button" data-close-market aria-label="Close">×</button></header><div class="hol-market-known"><strong>{{dp}} DP remaining</strong><p>{{#each knownRanks}}{{#unless @first}} · {{/unless}}{{name}} {{rank}}{{/each}}</p><p>{{#each currentBuild}}{{#unless @first}}, {{/unless}}{{name}}{{/each}}</p></div><label>Discipline<select data-market-filter><option value="all">All</option><option value="universal">Universal</option>{{#each disciplineFilters}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Search abilities and disciplines<input type="search" data-search placeholder="Search by name"></label>
 <div class="hol-choice-list">{{#each learning}}<article class="hol-choice {{#unless eligible}}hol-ineligible{{/unless}}" data-search-name="{{choice.name}}" data-choice-kind="{{choice.kind}}" data-eligible="{{eligible}}" data-discipline-ids="{{disciplineIds}}" data-universal="{{universal}}"><header><h3>{{choice.name}}</h3><span>{{cost}} DP {{#if nextRank}}· Rank {{nextRank}}{{/if}}</span></header><p>{{reasons}}</p>
 {{#if reference}}<details class="hol-ability-reference" data-ability-reference><summary><span>Ability rules reference</span><small>{{automationStatus}}</small></summary><div class="hol-ability-reference-body">{{#each reference.flavor}}<p class="hol-reference-flavor">{{this}}</p>{{/each}}<h4>Rules</h4><dl class="hol-reference-details">{{#each reference.rules.details}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl><div class="hol-reference-rules">{{#each reference.rules.body}}{{#if outcomes}}<dl class="hol-reference-outcomes">{{#each outcomes}}<dt>{{label}}</dt><dd>{{text}}</dd>{{/each}}</dl>{{else}}{{#if items}}<ul>{{#each items}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p>{{text}}</p>{{/if}}{{/if}}{{/each}}</div>{{#if reference.rules.notes}}<h4>Additional rulings</h4>{{#each reference.rules.notes}}<p>{{#if label}}<strong>{{label}}:</strong> {{/if}}{{text}}</p>{{/each}}{{/if}}</div></details>{{/if}}
 <button type="button" data-action="referenceChoice" data-id="{{#if choice.id}}{{choice.id}}{{else}}{{id}}{{/if}}">Read rules</button>
 {{#if recipeStudy}}<fieldset data-recipe-study="{{choice.id}}"><legend>Choose exactly two distinct recipes</legend>{{#each recipeSelections}}<label>{{label}}<select name="{{name}}"><option value="">Choose a recipe</option>{{#each options}}<option value="{{id}}" data-intrinsic-disabled="{{#if disabled}}true{{else}}false{{/if}}" {{#if selected}}selected{{/if}}{{#if disabled}} disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>{{/each}}</fieldset>{{/if}}
 <button type="button" data-action="addPurchase" data-id="{{choice.id}}" {{#unless eligible}}disabled{{/unless}}>Add {{choice.name}}</button></article>{{/each}}</div></dialog>{{/if}}
 {{#if equipmentStep}}<div class="hol-section-heading hol-equipment-heading"><span></span><button type="button" data-open-market="equipment">Buy inventory items</button></div><table class="hol-inventory-table hol-creation-inventory"><thead><tr><th>Item</th><th>Qty</th><th>Bulk</th><th>Supply</th><th>Source</th><th></th></tr></thead><tbody>{{#each creationInventoryItems}}<tr><td><button type="button" data-action="referenceChoice" data-id="{{catalogId}}">{{name}}</button></td><td>{{quantity}}</td><td>{{bulk}}</td><td>{{#if supply}}d{{supply}}{{else}}—{{/if}}</td><td>{{grantSource}}</td><td>{{#if removable}}<button type="button" data-action="removeEquipment" data-index="{{purchaseIndex}}" aria-label="Remove {{name}}">×</button>{{/if}}</td></tr>{{/each}}</tbody></table>
 <dialog class="hol-learning-market" data-learning-market="equipment"><header><h2 data-market-title>Buy equipment</h2><button type="button" data-close-market aria-label="Close">×</button></header><strong>{{inventory.remainingCoins}} coins remaining</strong><label>Search equipment<input type="search" data-search></label><div class="hol-choice-list">{{#each equipment}}<article class="hol-choice" data-search-name="{{name}}"><h3>{{name}}</h3><p>{{price}} coins · Bulk {{bulk}}{{#if inventoryDie}} · d{{inventoryDie}} supply{{/if}}</p><button type="button" data-action="referenceChoice" data-id="{{#if choice.id}}{{choice.id}}{{else}}{{id}}{{/if}}">Read rules</button>{{#if specialOrder}}<p>Special order: DA availability required.</p>{{else}}<label>Quantity<input type="number" name="quantity-{{id}}" min="1" step="1" value="1"></label>{{#if handChoices.length}}<label>Hands<select name="shop-hands-{{id}}">{{#each handChoices}}<option value="{{this}}">{{this}}</option>{{/each}}</select></label>{{/if}}<button type="button" data-action="addEquipment" data-id="{{id}}" {{#unless eligible}}disabled title="Requires {{requiredAbilityId}}"{{/unless}}>Add {{name}}</button>{{/if}}</article>{{/each}}</div></dialog>{{/if}}
 {{#if review}}{{#each importedRepairs}}<section class="hol-build-box"><h3>Level {{level}} · {{#if name}}{{name}}{{else}}Choices to repair{{/if}}</h3>{{#if signature}}<div class="hol-workshop-cards">{{#each signatureOptions}}<article class="hol-workshop-choice"><h3>{{name}}</h3><p>{{flavor}}</p><div class="hol-card-actions"><button type="button" data-action="referenceChoice" data-id="{{id}}">Read</button><button type="button" data-action="chooseImportedSignature" data-level="{{../level}}" data-tier="{{../signatureTier}}" data-id="{{id}}">Choose</button></div></article>{{/each}}</div>{{/if}}{{#if purchase}}<button type="button" data-action="removeImportedPurchase" data-level="{{level}}" data-index="{{index}}">Remove invalid purchase</button>{{/if}}{{#with acquisition}}<fieldset data-import-acquisition="{{id}}" data-level="{{level}}"><legend>Acquisition choices</legend>{{#if languageChoice}}<label>Language<select data-import-field="languageId"><option value="">Choose a language</option>{{#each languageOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}{{#if specialtyChoice}}<label>Specialty<input data-import-field="specialty" value="{{specialty}}" maxlength="120"></label>{{/if}}{{#if weaponOptions}}<label>Weapon<select data-import-field="weapon"><option value="">Choose equipment</option>{{#each weaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}{{#if needsHands}}<label>Hands used<select data-import-field="meleeHands"><option value="">Choose hands</option>{{#each handOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}{{#if recipeChoices}}<p>Choose {{recipeChoices}} recipes</p>{{#each recipes}}<label><input type="checkbox" data-import-field="recipes" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label>{{/each}}{{/if}}</fieldset>{{/with}}</section>{{/each}}{{#if valid}}<div class="hol-review-complete"><h3>Creation complete</h3><p>{{draft.name}} · {{characterAncestry}} {{characterClass}}</p></div>{{else}}<ul class="hol-error">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}<div class="hol-review-columns"><section class="hol-review-card"><h3>Your character</h3><table><tbody><tr><td>Maximum HP</td><td>{{summary.maximumHp}}</td></tr><tr><td>Grit</td><td>{{summary.gritGranted}}</td></tr><tr><td>Speed</td><td>{{summary.speed}}</td></tr><tr><td>Learned abilities</td><td>{{abilityCount}}</td></tr><tr><td>Coins</td><td>{{inventory.remainingCoins}}</td></tr></tbody></table></section><section class="hol-review-card"><h3>Save your character</h3>{{#if committed}}<p>Character creation is complete. Use advancement for later development.</p>{{else}}<p>Save the reviewed choices to this Foundry character. Its sheet opens when processing completes.</p>{{#if isGM}}{{#unless authorityBound}}<button type="button" data-action="bindAuthority">Enable GM processing</button>{{/unless}}{{/if}}{{/if}}<button type="button" data-action="saveDraft">Save draft</button></section></div><details class="hol-creation-ledger"><summary>Creation ledger</summary><table><thead><tr><th>Stage</th><th>Choice</th><th>DP</th><th>Remaining</th></tr></thead><tbody>{{#each ledger}}<tr><td>Level {{stage}}</td><td>{{source}}</td><td>{{delta}}</td><td>{{balance}}</td></tr>{{/each}}</tbody></table></details>{{/if}}
 </main></div></div>
 <footer class="hol-wizard-footer">{{#if hasPrevious}}<button type="button" data-action="navigate" data-step="{{previous}}">Back</button>{{/if}}<button type="button" data-action="saveDraft">Save draft</button>{{#if hasNext}}<button type="button" class="hol-primary" data-action="navigate" data-step="{{next}}">Continue →</button>{{/if}}{{#if review}}{{#unless committed}}<button type="button" data-action="commitCreation" class="hol-primary" {{#unless valid}}disabled{{/unless}}>Save character and return to sheet</button>{{/unless}}{{/if}}</footer>
<aside class="hol-creation-reference" data-creation-reference hidden aria-label="Rules reference"><header><h2>Rules reference</h2><button type="button" data-action="closeReference" aria-label="Close rules reference">×</button></header><div data-rule-content></div></aside>
</section>
