<section class="hol-body"><header class="hol-banner"><h1>{{name}}</h1><p>Hands, worn gear and equipment</p></header>
<fieldset {{#unless editable}}disabled{{/unless}}>
<input name="capacity" type="hidden" value="{{capacity}}">
{{#each items}}<div class="hol-pair" data-equipment-id="{{id}}"><label>{{name}} ({{quantity}} carried)<input name="hands" aria-label="Hands required for {{name}}" type="number" min="0" max="2" step="1" value="{{hands}}"></label><label>Holding one<input type="checkbox" name="held" {{checked held}}></label><label>Wearing<input type="checkbox" name="worn" {{checked worn}}></label></div>{{else}}<p>No equipment carried.</p>{{/each}}

{{#if editable}}<button type="button" data-action="save" class="hol-primary">Apply equipment arrangement</button>{{/if}}</fieldset></section>
