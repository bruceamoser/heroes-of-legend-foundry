<section class="hol-wizard">{{#if signatureFocus}}
<header class="hol-workshop-hero"><div class="hol-workshop-identity"><img src="{{actor.img}}" alt=""><div><h1>{{actor.name}}</h1><p>{{identityLine}} · Level {{current.level}}</p></div></div></header>
<main class="hol-wizard-main" data-signature-focus="{{signatureLevel}}">
{{#if stale}}<button type="button" data-action="refresh">Refresh choices</button><p class="hol-error">Your character changed. Refresh to review this signature choice.</p>{{/if}}
{{#each signatures}}<h2>Choose level {{level}} signature</h2><div class="hol-workshop-cards">{{#each options}}<article class="hol-workshop-choice {{#if selected}}is-selected{{/if}}"><h3>{{name}}</h3><p class="hol-card-copy">{{flavor}}</p><div class="hol-card-actions"><button type="button" data-action="referenceChoice" data-id="{{id}}">Read</button><button type="button" data-action="chooseSignature" data-id="{{id}}" data-level="{{../level}}" aria-pressed="{{selected}}" {{#if disabled}}disabled{{/if}}>{{#if selected}}Selected{{else}}Choose{{/if}}</button></div></article>{{/each}}</div>{{else}}<p>This signature has already been chosen or is not yet available.</p>{{/each}}
{{#each acquisitions}}<fieldset class="hol-required-choice" data-acquisition="{{id}}"><legend>{{name}}</legend>{{#if languageChoice}}<label>Language<select name="languageId-{{id}}"><option value="">Choose a language</option>{{#each languageOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}{{#if specialtyChoice}}<label>Performance specialty<input name="specialty-{{id}}" maxlength="120" value="{{specialty}}"></label>{{/if}}{{#if weaponOptions}}<label>Weapon<select name="weapon-{{id}}"><option value="">Choose equipment</option>{{#each weaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}{{#if needsHands}}<label>Melee weapon<select name="hands-{{id}}"><option value="">Choose its form</option>{{#each handOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}-handed</option>{{/each}}</select></label>{{/if}}{{#if recipeChoices}}<div data-recipes>Choose {{recipeChoices}} recipes.{{#each recipes}}<label><input type="checkbox" name="recipes-{{../id}}" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label>{{/each}}</div>{{/if}}</fieldset>{{/each}}
{{#if errors}}<ul class="hol-error">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
</main><footer class="hol-wizard-footer"><button type="button" data-action="returnSheet">Back to sheet</button><button type="button" data-action="commit" {{#unless canCommit}}disabled{{/unless}}>Save signature</button></footer><aside class="hol-creation-reference" data-creation-reference hidden aria-label="Rules reference"><header><h2>Rules reference</h2><button type="button" data-action="closeReference" aria-label="Close rules reference">×</button></header><div data-rule-content></div></aside>
{{else}}<header class="hol-workshop-hero"><div class="hol-workshop-identity"><img src="{{actor.img}}" alt=""><div><div class="hol-wizard-name"><h1>{{actor.name}}</h1><button type="button" data-action="wizardDeath" class="hol-wizard-death" title="Death roll" aria-label="Death roll"><i class="fa-solid fa-skull" aria-hidden="true"></i></button></div><p>{{identityLine}} · Level {{current.level}}({{current.dp}})</p></div></div><div class="hol-workshop-vitals"><div><small>HP</small><strong class="hol-wizard-hp"><input data-wizard-hp aria-label="Current HP" type="number" min="0" max="{{actor.system.health.max}}" step="1" value="{{actor.system.health.value}}"><span>/ {{maximumHp}}</span></strong></div><div><small><button type="button" data-action="wizardGrit" class="hol-wizard-vital-link">Grit</button></small><strong>{{gritAvailable}}</strong></div><div><small>Speed</small><strong>{{movement.speed}}{{#if movement.speedReduced}} / {{movement.unencumbered}}{{/if}}</strong></div><div><small><button type="button" data-action="wizardWounds" class="hol-wizard-vital-link">Wounds</button></small><strong>{{woundCount}}</strong></div><div><small>Armor DR</small><strong>{{armorDr}}</strong></div></div></header><div class="hol-workshop-attributes">{{#each headerAttributes}}<div><span>{{name}}</span><strong>{{value}}</strong></div>{{/each}}</div><div class="hol-wizard-layout"><nav aria-label="Development"><button type="button" data-action="returnSheet" aria-label="Development">{{{developmentIcon}}}<span>Development</span></button><button type="button" aria-current="step" aria-label="Spend DP">{{{learningIcon}}}<span>Spend DP</span></button></nav><div class="hol-wizard-body"><div class="hol-workshop-context"><strong>{{dp}} DP remaining</strong><span>Level {{current.level}}</span><div class="hol-discipline-strip">{{#each knownRanks}}<span class="hol-discipline-chip"><img src="{{mark}}" alt="">{{name}} {{rank}}</span>{{/each}}</div></div><main class="hol-wizard-main">{{#if requiredChoices}}<aside class="hol-required-banner"><strong>Required choices</strong>{{#each requiredChoices}}<button type="button" data-required-choice="{{id}}">{{name}}</button>{{/each}}</aside>{{/if}}
<div class="hol-tool-actions"><button type="button" data-action="award">Add level</button>{{#if canRemoveLevel}}<button type="button" data-action="removeLevel">Remove level</button>{{/if}}</div>
{{#if stale}}<button type="button" data-action="refresh">Refresh choices</button><p class="hol-error">Your character changed since these choices were saved. Refresh to review your pending choices with the current level, DP and abilities.</p>{{/if}}
{{#each signatures}}<h2>Choose level {{level}} signature</h2><div class="hol-workshop-cards">{{#each options}}<article class="hol-workshop-choice {{#if selected}}is-selected{{/if}}"><h3>{{name}}</h3><p class="hol-card-copy">{{flavor}}</p><div class="hol-card-actions"><button type="button" data-action="referenceChoice" data-id="{{id}}">Read</button><button type="button" data-action="chooseSignature" data-id="{{id}}" data-level="{{../level}}" {{#if disabled}}disabled{{/if}}>{{#if selected}}Selected{{else}}Choose{{/if}}</button></div></article>{{/each}}</div>{{/each}}
<div class="hol-section-heading"><h2>Level {{current.level}} learning</h2><div><button type="button" data-open-market="ability">Learn abilities</button><button type="button" data-open-market="discipline">Learn discipline</button></div></div><section class="hol-build-box"><h3>Current Build</h3><ul class="hol-current-build">{{#each currentBuild}}<li><div><button type="button" data-action="referenceChoice" data-id="{{id}}">{{name}}</button><small>{{grantSource}}</small>{{#if removable}}<button type="button" data-action="remove" data-index="{{index}}">Remove</button>{{else}}{{#if refund}}<button type="button" data-action="refundAbility" data-id="{{id}}">Remove · refund {{refund.cost}} DP</button>{{else}}<span></span>{{/if}}{{/if}}</div>{{#with acquisition}}<div class="hol-required-choice"><fieldset data-acquisition="{{id}}"><legend>{{name}} · Acquisition choices</legend>{{#if languageChoice}}<label>Ordinary language and normal script<select name="languageId-{{id}}"><option value="">Choose a language</option>{{#each languageOptions}}<option value="{{id}}" data-intrinsic-disabled="{{#if disabled}}true{{else}}false{{/if}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>{{/if}}{{#if specialtyChoice}}<label>Mundane performance specialty<input name="specialty-{{id}}" maxlength="120" value="{{specialty}}" placeholder="e.g. juggling or singing"></label>{{/if}}{{#if weaponOptions}}<label>Weapon<select name="weapon-{{id}}"><option value="">Choose equipment</option>{{#each weaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}{{#if needsHands}}<label>Melee hand use<select name="hands-{{id}}"><option value="">Choose if a weapon is granted</option>{{#each handOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}{{#if recipeChoices}}<div data-recipes>Choose {{recipeChoices}} recipes.{{#each recipes}}<label><input type="checkbox" name="recipes-{{../id}}" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label>{{/each}}</div>{{/if}}</fieldset></div>{{/with}}</li>{{/each}}{{#each disciplinePurchases}}<li><div><strong>{{name}}</strong><small>Discipline purchase</small><button type="button" data-action="remove" data-index="{{index}}">Remove</button></div></li>{{/each}}</ul></section>
{{#if errors}}<h2>Choices to repair</h2><ul class="hol-error">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}

<dialog class="hol-learning-market" data-learning-market="learning"><header><h2 data-market-title>Learn abilities</h2><button type="button" data-close-market aria-label="Close">×</button></header><div class="hol-market-known"><strong>{{dp}} DP remaining</strong><p>{{#each knownRanks}}{{#unless @first}} · {{/unless}}{{name}} {{rank}}{{/each}}</p><p>{{#each currentBuild}}{{#unless @first}}, {{/unless}}{{name}}{{/each}}</p></div><label>Discipline<select data-market-filter><option value="all">All</option><option value="universal">Universal</option>{{#each disciplineFilters}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Search abilities and disciplines<input type="search" data-search></label><div class="hol-choice-list">{{#each learning}}<article class="hol-choice hol-learning-card {{#unless eligible}}hol-ineligible{{/unless}}" data-search-name="{{choice.name}}" data-choice-kind="{{choice.kind}}" data-eligible="{{eligible}}" data-discipline-ids="{{disciplineIds}}" data-universal="{{universal}}"><header><h3>{{choice.name}}</h3><div class="hol-learning-badges">{{#if actionCode}}<span class="hol-action-code" title="{{actionLabel}}" aria-label="{{actionLabel}}">{{actionCode}}</span>{{/if}}{{#each marks}}<span class="hol-learning-mark" title="{{name}} {{rank}}"><img src="{{src}}" alt="{{name}}">{{#if rankLabel}}<small>{{rankLabel}}</small>{{/if}}</span>{{/each}}</div></header>{{#if reasons}}<p class="hol-learning-reason">{{reasons}}</p>{{/if}}<div class="hol-learning-actions"><button type="button" data-action="referenceChoice" data-id="{{choice.id}}">Read rules</button><button type="button" data-action="add" data-id="{{choice.id}}" {{#unless eligible}}disabled{{/unless}}>{{cost}} DP · Learn{{#if rank}} rank {{rank}}{{/if}}</button></div>{{#if recipeStudy}}<fieldset data-recipe-study="{{choice.id}}"><legend>Choose exactly two distinct recipes</legend>{{#each recipeSelections}}<label>{{label}}<select name="{{name}}"><option value="">Choose a recipe</option>{{#each options}}<option value="{{id}}" data-intrinsic-disabled="{{#if disabled}}true{{else}}false{{/if}}" {{#if selected}}selected{{/if}}{{#if disabled}} disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>{{/each}}</fieldset>{{/if}}</article>{{/each}}</div></dialog>
</main></div></div><footer class="hol-wizard-footer"><button type="button" data-action="returnSheet">Back to development</button><button type="button" data-action="commit" {{#unless canCommit}}disabled{{/unless}}>Done</button></footer><aside class="hol-creation-reference" data-creation-reference hidden aria-label="Rules reference"><header><h2>Rules reference</h2><button type="button" data-action="closeReference" aria-label="Close rules reference">×</button></header><div data-rule-content></div></aside>{{/if}}</section>
