<section class="hol-wizard"><header class="hol-banner"><p class="hol-kicker">Character development</p><h1>{{actor.name}}</h1><p>Level {{current.level}} · {{current.dp}} banked DP · {{current.gritGranted}} Grit granted, {{current.gritSpent}} spent</p></header>
<main class="hol-wizard-main">
{{#if isGM}}{{#unless authorityBound}}<button type="button" data-action="bindAuthority">Enable character processing in this GM window</button>{{/unless}}<details><summary>DA milestone and safe-place controls</summary><label>Award milestone level<input type="number" name="newLevel" min="{{nextLevel}}" step="1" value="{{nextLevel}}"></label><button type="button" data-action="award">Award milestone</button><label><input type="checkbox" name="safePlace" {{#if current.safePlace}}checked{{/if}}> DA-approved safe place</label><button type="button" data-action="safePlace">Apply safe-place decision</button></details>{{/if}}
<button type="button" data-action="refresh">Refresh and review current ledger</button>{{#if stale}}<p class="hol-error">The committed ledger changed. Refresh to review these choices against it.</p>{{/if}}
{{#unless current.safePlace}}<p class="hol-note">DP stays banked. Purchases require a DA-approved safe place.</p>{{/unless}}
{{#each signatures}}<label>Choose your level-{{level}} signature<select data-signature="{{level}}"><option value="">Choose a signature</option>{{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}</option>{{/each}}</select></label>{{/each}}
<div class="hol-budget"><strong>After this draft: {{dp}} DP · Maximum HP {{maximumHp}} · Grit {{grit}} ({{spent}} spent)</strong><p>HP training increases maximum HP; it does not heal. Grit expenditure stays spent.</p></div>
<h2>Planned purchases</h2><ol>{{#each purchases}}<li>{{name}}{{#if recipeNames}} <small>Recipes: {{#each recipeNames}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}</small>{{/if}} <button type="button" data-action="remove" data-index="{{index}}">Remove</button>{{#if legacyRecipePurchase}}<p class="hol-error">This saved recipe purchase needs two recipe choices. Remove it, then add Ordinary Recipe Study with your chosen pair.</p>{{/if}}</li>{{else}}<li>No purchases yet.</li>{{/each}}</ol>
{{#each acquisitions}}<fieldset data-acquisition="{{id}}"><legend>{{name}} · Acquisition choices</legend>{{#if weaponOptions}}<label>Weapon<select name="weapon-{{id}}"><option value="">Choose equipment</option>{{#each weaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></label>{{/if}}{{#if needsHands}}<label>Melee hand use<select name="hands-{{id}}"><option value="">Choose if a weapon is granted</option>{{#each handOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}{{#if recipeChoices}}<div data-recipes>Choose {{recipeChoices}} recipes.{{#each recipes}}<label><input type="checkbox" name="recipes-{{../id}}" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label>{{/each}}</div>{{/if}}</fieldset>{{/each}}
{{#if errors}}<h2>Choices to repair</h2><ul class="hol-error">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
<label>Search abilities and disciplines<input type="search" data-search></label><div class="hol-choice-list">{{#each learning}}<article class="hol-choice {{#unless eligible}}hol-ineligible{{/unless}}" data-search-name="{{choice.name}}"><h3>{{choice.name}}</h3><p>{{cost}} DP {{#if rank}}· Rank {{rank}}{{/if}}</p><p>{{reasons}}</p>{{#if reference}}<details class="hol-ability-reference" data-ability-reference><summary><span>Ability rules reference</span><small>{{automationStatus}}</small></summary><div class="hol-ability-reference-body">{{#each reference.flavor}}<p class="hol-reference-flavor">{{this}}</p>{{/each}}<h4>Rules</h4><dl class="hol-reference-details">{{#each reference.rules.details}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl><div class="hol-reference-rules">{{#each reference.rules.body}}{{#if outcomes}}<dl class="hol-reference-outcomes">{{#each outcomes}}<dt>{{label}}</dt><dd>{{text}}</dd>{{/each}}</dl>{{else}}{{#if items}}<ul>{{#each items}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p>{{text}}</p>{{/if}}{{/if}}{{/each}}</div>{{#if reference.rules.notes}}<h4>Additional rulings</h4>{{#each reference.rules.notes}}<p>{{#if label}}<strong>{{label}}:</strong> {{/if}}{{text}}</p>{{/each}}{{/if}}</div></details>{{/if}}<a href="{{source}}" target="_blank" rel="noopener">Read book rules</a>{{#if recipeStudy}}<fieldset data-recipe-study="{{choice.id}}"><legend>Choose exactly two distinct recipes</legend>{{#each recipeSelections}}<label>{{label}}<select name="{{name}}"><option value="">Choose a recipe</option>{{#each options}}<option value="{{id}}" data-intrinsic-disabled="{{#if disabled}}true{{else}}false{{/if}}" {{#if selected}}selected{{/if}}{{#if disabled}} disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>{{/each}}</fieldset>{{/if}}<button type="button" data-action="add" data-id="{{choice.id}}" {{#unless eligible}}disabled{{/unless}}>Add {{choice.name}}</button></article>{{/each}}</div>
</main><footer class="hol-wizard-footer"><button type="button" data-action="save">Save draft</button><button type="button" data-action="commit" {{#unless canCommit}}disabled{{/unless}}>Commit reviewed advancement</button></footer></section>
