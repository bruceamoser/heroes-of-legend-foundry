<section class="hol-body"><header class="hol-banner"><h1>{{name}}</h1><p>Conditions</p></header>

<ul>{{#each summary}}<li><strong>{{key}}</strong>: {{#if (eq kind "binary")}}active{{else}}{{rating}}{{/if}} · temporary {{temporary}}, persistent {{persistent}}{{#if canApply}} <button type="button" data-action="applyTick" data-key="{{key}}">Apply damage</button>{{/if}}</li>{{else}}<li>No active HOL conditions.</li>{{/each}}</ul>
{{#if owner}}<h2>Add condition</h2><div class="hol-pair"><label>Condition<select name="key">{{#each keys}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{key}}</option>{{/each}}</select></label><label>Rating<input name="rating" type="number" value="{{draft.rating}}" min="1" step="1" {{#if binary}}readonly{{/if}}></label></div>
<div class="hol-pair"><label>Persistence<select name="persistence">{{#each persistence}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label></div><button type="button" data-action="add">Add condition</button>{{/if}}
<h2>Active conditions</h2><ul class="hol-condition-sources">{{#each contributions}}<li><strong>{{key}} {{rating}}</strong> · {{persistence}}{{#if ../owner}}{{#if temporary}}<button type="button" data-action="reduce" data-id="{{id}}">−1</button>{{/if}}<button type="button" data-action="remove" data-id="{{id}}">Remove</button>{{/if}}</li>{{else}}<li>No conditions.</li>{{/each}}</ul>
</section>
