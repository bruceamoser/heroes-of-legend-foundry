<section class="hol-attack-card hol-player-attack-card">
  <h3>{{attackerName}} · {{title}}</h3>
  <p>Target: {{targetName}} · one Brawn attack roll · {{tierLabel}} ({{total}})</p>
  <p>Retained dice: {{retained}} · Weapon: {{weaponName}}</p>
  <p><strong>{{damage}} Physical damage before resistance.</strong></p>
  <p>One Main Action spent. This is the attacker's one roll; no Defend roll is created for this result.</p>
  {{#if recovery}}<p class="hol-note">DA retained-dice recovery: {{recovery.reason}}</p>{{/if}}
  <p class="hol-attack-damage-status" role="status"></p>
</section>
