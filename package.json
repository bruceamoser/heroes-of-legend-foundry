{
  "name": "heroes-of-legend-foundry",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run validate && npm test",
    "test:runtime": "node scripts/smoke-foundry.mjs",
    "test:sheets": "node scripts/test-sheets.mjs",
    "test:rolls": "node scripts/check-rolls.mjs",
    "test:authority": "node scripts/check-authority.mjs",
    "probe:claims": "node scripts/probe-document-claims.mjs",
    "stage:pack-probe": "node scripts/stage-pack-probe.mjs",
    "test:pack-runtime": "node scripts/check-packs.mjs",
    "test:timing": "node scripts/check-timing.mjs",
    "test:canvas": "node scripts/check-canvas.mjs",
    "import:choices": "node scripts/import-choices.mjs",
    "validate:choices": "node scripts/import-choices.mjs --check",
    "import:inventory": "node scripts/import-inventory.mjs",
    "validate:inventory": "node scripts/import-inventory.mjs --check",
    "test:creation": "node scripts/check-creation.mjs",
    "test:creation-commit": "node scripts/check-creation-commit.mjs",
    "test:advancement": "node scripts/check-advancement.mjs",
    "test:coordinator": "node scripts/check-coordinator.mjs",
    "test:coordinator-restart": "node scripts/check-coordinator-restart.mjs",
    "test:combat": "node scripts/check-combat.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "3.0.5",
    "@playwright/test": "^1.64.1"
  }
}
