<section class="hol-wizard">
 <header class="hol-banner"><p class="hol-kicker">Heroes of Legend · Character creation</p><h1>{{draft.name}}</h1><p>Your draft is separate from your character. Save at any time, then resume from the sheet.</p>{{#unless committed}}<button type="button" data-action="importCharacter">Import character JSON</button>{{/unless}}</header>
 <div class="hol-wizard-layout">
 <nav aria-label="Creation steps">{{#each steps}}<button type="button" data-action="navigate" data-step="{{index}}" {{#if active}}aria-current="step"{{/if}}>{{name}}</button>{{/each}}<small>Saved revision {{revision}}</small></nav>
 <main class="hol-wizard-main">{{#if requiredChoices}}<aside class="hol-required-banner"><strong>Required choices</strong>{{#each requiredChoices}}<button type="button" data-required-choice="{{id}}">{{name}}</button>{{/each}}</aside>{{/if}}<h2>{{title}}</h2>
 {{#if identity}}
 <label>Character name<input name="heroName" value="{{draft.name}}"></label>
 <p>Assign −2 to +2 to each attribute, totaling +3. Current total: <strong>{{attributeTotal}}</strong>. Knowledge, Reason and Guile determine each creation DP pool.</p>
 <div class="hol-attributes">{{#each attributes}}<label>{{name}}<input name="attribute-{{id}}" type="number" min="-2" max="2" step="1" value="{{value}}"></label>{{/each}}</div>
 {{/if}}
 {{#if ancestry}}
 <label>Ancestry<select name="ancestryId"><option value="">Choose an ancestry</option>{{#each ancestries}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · HP {{hp}} · Speed {{speed}}</option>{{/each}}</select></label>
 <p>Save an ancestry choice to show its traits. Choose exactly two.</p>
 <fieldset><legend>Ancestry traits</legend>{{#each traits}}<label><input type="checkbox" name="trait" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label>{{/each}}</fieldset>
 <label>Remembered community (Age of Memory)<input name="rememberedCommunity" value="{{draft.rememberedCommunity}}"></label>
 <fieldset class="hol-language-choices" data-language-choice="home"><legend>Home language (Common is already known)</legend><p>Choose one named ordinary language from this campaign. Unavailable definitions remain listed with the reason they cannot be selected.</p>{{#each languages}}<label class="hol-choice hol-language-choice {{#unless eligible}}hol-ineligible{{/unless}} {{#if repair}}hol-repair{{/if}}" data-language-option="{{id}}"><input type="radio" name="homeLanguage" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}}> <strong>{{name}}</strong><small>{{summary}}</small>{{#if reason}}<small class="hol-error">{{reason}}</small>{{/if}}</label>{{/each}}</fieldset>
 {{#if manyHomes}}<fieldset class="hol-language-choices" data-language-choice="extra"><legend>Two additional spoken languages</legend><p>These extra grants do not grant literacy or a signed language.</p>{{#each extraLanguages}}<label class="hol-choice hol-language-choice {{#unless eligible}}hol-ineligible{{/unless}} {{#if repair}}hol-repair{{/if}}" data-language-option="{{id}}"><input type="checkbox" name="extraLanguage" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}}> <strong>{{name}}</strong><small>{{summary}}</small>{{#if reason}}<small class="hol-error">{{reason}}</small>{{/if}}</label>{{/each}}</fieldset>{{/if}}
 {{/if}}
 {{#if origins}}<p>Each origin grants one complete discipline-and-ability pair. A duplicate grant adds 1 DP to the level-0 pool.</p>
 <label>Culture<select name="culture"><option value="">Choose culture and grant pair</option>{{#each culturePairs}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
 <label>Background<select name="background"><option value="">Choose background and grant pair</option>{{#each backgroundPairs}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
 {{#if classStep}}<p>Classes meeting your attribute requirements appear first. Save a class choice to show its starting disciplines and signatures.</p>
 <fieldset><legend>Class</legend>{{#each classes}}<label class="hol-choice {{#unless eligible}}hol-ineligible{{/unless}}"><input type="radio" name="classId" value="{{choice.id}}" {{#if selected}}checked{{/if}} {{#unless eligible}}disabled{{/unless}}> <strong>{{choice.name}}</strong> · HP {{choice.hp}}<small>{{reasons}}</small></label>{{/each}}</fieldset>
 <fieldset><legend>Choose two starting disciplines</legend>{{#each classDisciplines}}<label><input type="checkbox" name="classDiscipline" value="{{id}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}}> {{name}}</label>{{/each}}</fieldset>
 <label>Level-1 signature<select name="signatureId"><option value="">Choose one signature</option>{{#each signatures}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
 {{#if learningStep}}
 <p class="hol-note">Add a listed choice or drop a catalog ability here.</p>
 <div class="hol-budget"><strong>Level {{stage}} · {{dp}} DP remaining</strong><p>Unused DP expires when this creation stage closes. Later grants cannot qualify an earlier purchase.</p></div>
 <div class="hol-section-heading"><h3>Current Build</h3><div><button type="button" data-open-market="ability">Learn abilities</button>{{#if showDisciplineMarket}}<button type="button" data-open-market="discipline">Learn discipline</button>{{/if}}</div></div><ul class="hol-current-build">{{#each currentBuild}}<li><div><strong>{{name}}</strong><small>{{#if removable}}Current learning{{else}}Granted / earlier learning{{/if}}</small>{{#if removable}}<button type="button" data-action="removePurchase" data-index="{{index}}">Remove</button>{{else}}<span>Locked</span>{{/if}}</div>{{#with acquisition}}<div class="hol-required-choice"><fieldset data-acquisition="{{id}}"><legend>{{name}}</legend>{{#if languageChoice}}<label>Ordinary language and normal script<select name="languageId-{{id}}"><option value="">Choose a language</option>{{#each languageOptions}}<option value="{{id}}" data-intrinsic-disabled="{{#if disabled}}true{{else}}false{{/if}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>{{/if}}{{#if specialtyChoice}}<label>Mundane performance specialty<input name="specialty-{{id}}" maxlength="120" value="{{specialty}}" placeholder="e.g. juggling or singing"></label>{{/if}}
 {{#if weaponOptions}}<label>Attack equipment<select name="weapon-{{id}}"><option value="">Choose equipment</option>{{#each weaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
 {{#if needsHands}}<label>Melee weapon hand use<select name="hands-{{id}}"><option value="">Choose if a weapon is granted</option>{{#each handOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}
 {{#if recipeChoices}}<div data-recipes><p>Choose {{recipeChoices}} ordinary recipes.</p>{{#each recipes}}<label><input type="checkbox" name="recipes-{{../id}}" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label>{{/each}}</div>{{/if}}</fieldset></div>{{/with}}</li>{{/each}}{{#each disciplinePurchases}}<li><div><strong>{{name}}</strong><small>Discipline purchase</small><button type="button" data-action="removePurchase" data-index="{{index}}">Remove</button></div></li>{{/each}}</ul>
 {{/if}}
 {{#unless learningStep}}{{#if acquisitions}}{{#unless review}}{{#unless identity}}{{#unless ancestry}}{{#unless origins}}{{#unless classStep}}
 <details open><summary>Equipment and recipe choices from learned abilities</summary><p>Compatible abilities share equipment. Recipes grant knowledge, never ingredients or finished supplies. Save choices to refresh eligibility.</p>
 {{#each acquisitions}}<fieldset data-acquisition="{{id}}"><legend>{{name}}</legend>{{#if languageChoice}}<label>Ordinary language and normal script<select name="languageId-{{id}}"><option value="">Choose a language</option>{{#each languageOptions}}<option value="{{id}}" data-intrinsic-disabled="{{#if disabled}}true{{else}}false{{/if}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>{{/if}}{{#if specialtyChoice}}<label>Mundane performance specialty<input name="specialty-{{id}}" maxlength="120" value="{{specialty}}" placeholder="e.g. juggling or singing"></label>{{/if}}
 {{#if weaponOptions}}<label>Attack equipment<select name="weapon-{{id}}"><option value="">Choose equipment</option>{{#each weaponOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
 {{#if needsHands}}<label>Melee weapon hand use<select name="hands-{{id}}"><option value="">Choose if a weapon is granted</option>{{#each handOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}
 {{#if recipeChoices}}<div data-recipes><p>Choose {{recipeChoices}} ordinary recipes.</p>{{#each recipes}}<label><input type="checkbox" name="recipes-{{../id}}" value="{{id}}" {{#if selected}}checked{{/if}}> {{name}}</label>{{/each}}</div>{{/if}}</fieldset>{{/each}}</details>
 {{/unless}}{{/unless}}{{/unless}}{{/unless}}{{/unless}}{{/if}}
{{/unless}}
 {{#if learningStep}}<dialog class="hol-learning-market" data-learning-market="learning"><header><h2 data-market-title>Learn abilities</h2><button type="button" data-close-market aria-label="Close">×</button></header><div class="hol-market-known"><strong>{{dp}} DP remaining</strong><p>{{#each knownRanks}}{{#unless @first}} · {{/unless}}{{name}} {{rank}}{{/each}}</p><p>{{#each currentBuild}}{{#unless @first}}, {{/unless}}{{name}}{{/each}}</p></div><label>Discipline<select data-market-filter><option value="all">All</option><option value="universal">Universal</option>{{#each disciplineFilters}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Search abilities and disciplines<input type="search" data-search placeholder="Search by name"></label>
 <div class="hol-choice-list">{{#each learning}}<article class="hol-choice {{#unless eligible}}hol-ineligible{{/unless}}" data-search-name="{{choice.name}}" data-choice-kind="{{choice.kind}}" data-discipline-ids="{{disciplineIds}}" data-universal="{{universal}}"><header><h3>{{choice.name}}</h3><span>{{cost}} DP {{#if nextRank}}· Rank {{nextRank}}{{/if}}</span></header><p>{{reasons}}</p>
 {{#if reference}}<details class="hol-ability-reference" data-ability-reference><summary><span>Ability rules reference</span><small>{{automationStatus}}</small></summary><div class="hol-ability-reference-body">{{#each reference.flavor}}<p class="hol-reference-flavor">{{this}}</p>{{/each}}<h4>Rules</h4><dl class="hol-reference-details">{{#each reference.rules.details}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl><div class="hol-reference-rules">{{#each reference.rules.body}}{{#if outcomes}}<dl class="hol-reference-outcomes">{{#each outcomes}}<dt>{{label}}</dt><dd>{{text}}</dd>{{/each}}</dl>{{else}}{{#if items}}<ul>{{#each items}}<li>{{this}}</li>{{/each}}</ul>{{else}}<p>{{text}}</p>{{/if}}{{/if}}{{/each}}</div>{{#if reference.rules.notes}}<h4>Additional rulings</h4>{{#each reference.rules.notes}}<p>{{#if label}}<strong>{{label}}:</strong> {{/if}}{{text}}</p>{{/each}}{{/if}}</div></details>{{/if}}
 <a href="{{source}}" target="_blank" rel="noopener">Read book rules</a>
 {{#if recipeStudy}}<fieldset data-recipe-study="{{choice.id}}"><legend>Choose exactly two distinct recipes</legend>{{#each recipeSelections}}<label>{{label}}<select name="{{name}}"><option value="">Choose a recipe</option>{{#each options}}<option value="{{id}}" data-intrinsic-disabled="{{#if disabled}}true{{else}}false{{/if}}" {{#if selected}}selected{{/if}}{{#if disabled}} disabled{{/if}}>{{name}}{{#if reason}} — {{reason}}{{/if}}</option>{{/each}}</select></label>{{/each}}</fieldset>{{/if}}
 <button type="button" data-action="addPurchase" data-id="{{choice.id}}" {{#unless eligible}}disabled{{/unless}}>Add {{choice.name}}</button></article>{{/each}}</div></dialog>{{/if}}
 {{#if equipmentStep}}<div class="hol-budget"><strong>{{inventory.remainingCoins}} coins remaining · {{inventory.bulk}} Bulk</strong><p>Starting coins: {{inventory.startingCoins}}. Planned spending: {{inventory.spent}}. One plain worn outfit is included. Containers add their own Bulk.</p></div>
 <div class="hol-section-heading"><h3>Starting inventory</h3><button type="button" data-open-market="equipment">Buy equipment</button></div><ul>{{#each shopping}}<li>{{quantity}} × {{name}} <button type="button" data-action="removeEquipment" data-index="{{index}}">Remove</button></li>{{else}}<li>No purchases.</li>{{/each}}</ul>
 <dialog class="hol-learning-market" data-learning-market="equipment"><header><h2 data-market-title>Buy equipment</h2><button type="button" data-close-market aria-label="Close">×</button></header><strong>{{inventory.remainingCoins}} coins remaining</strong><label>Search equipment<input type="search" data-search></label><div class="hol-choice-list">{{#each equipment}}<article class="hol-choice" data-search-name="{{name}}"><h3>{{name}}</h3><p>{{price}} coins · Bulk {{bulk}}{{#if inventoryDie}} · d{{inventoryDie}} supply{{/if}}</p><a href="{{source}}" target="_blank" rel="noopener">Read book rules</a>{{#if specialOrder}}<p>Special order: DA availability required.</p>{{else}}<label>Quantity<input type="number" name="quantity-{{id}}" min="1" step="1" value="1"></label>{{#if handChoices.length}}<label>Hands<select name="shop-hands-{{id}}">{{#each handChoices}}<option value="{{this}}">{{this}}</option>{{/each}}</select></label>{{/if}}<button type="button" data-action="addEquipment" data-id="{{id}}" {{#unless eligible}}disabled title="Requires {{requiredAbilityId}}"{{/unless}}>Add {{name}}</button>{{/if}}</article>{{/each}}</div></dialog>{{/if}}
 {{#if review}}
 {{#if valid}}<p class="hol-budget">All creation choices are valid.</p>{{else}}<h3>Choices to repair</h3><ul class="hol-error">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
 {{#if summary}}<dl class="hol-summary"><dt>Maximum HP</dt><dd>{{summary.maximumHp}}</dd><dt>Grit</dt><dd>{{summary.gritGranted}}</dd><dt>Speed without encumbrance</dt><dd>{{summary.unencumberedSpeed}}</dd><dt>Carrying capacity</dt><dd>{{summary.capacity}}</dd><dt>Coins remaining</dt><dd>{{inventory.remainingCoins}}</dd><dt>Bulk</dt><dd>{{inventory.bulk}}</dd></dl>{{/if}}
 <h3>Languages</h3><ul class="hol-language-summary">{{#each languageSummary}}<li><strong>{{name}}</strong> · {{form}} · {{permissions}} <small>from {{source}}</small></li>{{else}}<li>No language grants are available until the draft is complete.</li>{{/each}}</ul>
 <h3>Abilities</h3><ul>{{#each knownAbilities}}<li>{{this}}</li>{{/each}}</ul><h3>Recipes</h3><ul>{{#each knownRecipes}}<li>{{this}}</li>{{else}}<li>None.</li>{{/each}}</ul>
 <h3>Equipment</h3><ul>{{#each inventoryItems}}<li>{{quantity}} × {{name}}</li>{{/each}}</ul>
 <details><summary>DP ledger</summary><table><thead><tr><th>Stage</th><th>Reason</th><th>Source</th><th>Change</th><th>Balance</th></tr></thead><tbody>{{#each ledger}}<tr><td>{{stage}}</td><td>{{kind}}</td><td>{{source}}</td><td>{{delta}}</td><td>{{balance}}</td></tr>{{/each}}</tbody></table></details>
 {{#if committed}}<p>Character creation is complete. Use advancement for later development.</p>{{else}}
 {{#if isGM}}{{#unless authorityBound}}<button type="button" data-action="bindAuthority">Enable character processing in this GM window</button>{{/unless}}{{/if}}
 {{#if valid}}<button type="button" data-action="commitCreation" class="hol-primary">Create this character</button>{{/if}}
 {{#unless authorityBound}}<p>A GM must enable character processing before a draft can be committed.</p>{{/unless}}{{/if}}{{/if}}
 </main></div>
 <footer class="hol-wizard-footer">{{#if hasPrevious}}<button type="button" data-action="navigate" data-step="{{previous}}">Back</button>{{/if}}<button type="button" data-action="saveDraft">Save choices</button>{{#if hasNext}}<button type="button" class="hol-primary" data-action="navigate" data-step="{{next}}">Save and continue</button>{{/if}}</footer>
</section>
